{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2019",
    "outDir": "out",
    "lib": [
      "ES2019"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "vscode-jsonrpc": ["node_modules/vscode-jsonrpc/lib/common/api.d.ts"],
      "vscode-jsonrpc/node": ["node_modules/vscode-jsonrpc/lib/node/main.d.ts"]
    },
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vscode",
      "mocha"
    ]
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "tests",
    "src/webview",
    "wt",
    "vitest.config.ts",
    "vitest.bench.config.ts",
    "vitest.integration.config.ts"
  ]
}
