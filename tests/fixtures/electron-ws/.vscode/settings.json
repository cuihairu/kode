{
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        ".kbengine/**": true
    },
    "python.analysis.extraPaths": [
        "${workspaceFolder}/scripts",
        "${workspaceFolder}/.kbengine/stubs"
    ],
    "files.watcherExclude": {
        ".git/objects/**": true,
        ".git/subtree-cache/**": true,
        ".hg/store/**": true,
        "*/.git/objects/**": true,
        "*/.git/subtree-cache/**": true,
        "*/.hg/store/**": true,
        ".kbengine/**": true
    },
    "files.associations": {
        "**/.kbengine/debug.json": "jsonc"
    }
}