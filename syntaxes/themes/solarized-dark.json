{
  "name": "KBEngine (Solarized Dark)",
  "semanticHighlighting": false,
  "colors": {
    "editor.background": "#002B36",
    "editor.foreground": "#839496",
    "activityBarBadge.background": "#268BD2",
    "sideBarTitle.foreground": "#839496"
  },
  "tokenColors": [
    {
      "name": "Default Foreground",
      "scope": [
        "source",
        "text.xml"
      ],
      "settings": {
        "foreground": "#839496"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#657B83",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2AA198"
      }
    },
    {
      "name": "String Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#CB4B16"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#CB4B16"
      }
    },
    {
      "name": "Numbers and Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#CB4B16"
      }
    },
    {
      "name": "Function Names",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#B58900"
      }
    },
    {
      "name": "Class Names",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#B58900"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#268BD2"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#93A1A1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorator and self",
      "scope": [
        "variable.language",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Attribute Names",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#B58900"
      }
    },
    {
      "name": "XML Tag Punctuation",
      "scope": [
        "punctuation.definition.tag.xml",
        "punctuation.definition.tag.begin.xml",
        "punctuation.definition.tag.end.xml"
      ],
      "settings": {
        "foreground": "#586E75"
      }
    },
    {
      "name": "XML Tags",
      "scope": [
        "entity.name.tag.xml",
        "entity.name.tag.localname.xml"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "XML Attribute Names",
      "scope": "entity.other.attribute-name.xml",
      "settings": {
        "foreground": "#B58900"
      }
    },
    {
      "name": "KBEngine Properties Section",
      "scope": "entity.name.tag.section.properties.kbengine",
      "settings": {
        "foreground": "#93A1A1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Base Methods Section",
      "scope": "entity.name.tag.section.base-methods.kbengine",
      "settings": {
        "foreground": "#B58900",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Cell Methods Section",
      "scope": "entity.name.tag.section.cell-methods.kbengine",
      "settings": {
        "foreground": "#268BD2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Client Methods Section",
      "scope": "entity.name.tag.section.client-methods.kbengine",
      "settings": {
        "foreground": "#CB4B16",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Exposed",
      "scope": [
        "entity.name.tag.exposed.kbengine",
        "constant.language.exposed.kbengine"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "KBEngine Persistent",
      "scope": [
        "entity.name.tag.persistent.kbengine",
        "constant.language.persistent.kbengine"
      ],
      "settings": {
        "foreground": "#93A1A1"
      }
    },
    {
      "name": "KBEngine Flags",
      "scope": "constant.language.flag.kbengine",
      "settings": {
        "foreground": "#268BD2"
      }
    },
    {
      "name": "KBEngine Type Aliases",
      "scope": [
        "support.class.kbengine",
        "support.type.kbengine"
      ],
      "settings": {
        "foreground": "#268BD2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Builtin Types (types.xml)",
      "scope": "support.type.kbengine.builtin",
      "settings": {
        "foreground": "#268BD2"
      }
    },
    {
      "name": "KBEngine Custom Types (types.xml)",
      "scope": "entity.name.type.kbengine.custom",
      "settings": {
        "foreground": "#B58900"
      }
    },
    {
      "name": "KBEngine Array Directive (type[])",
      "scope": "keyword.other.kbengine.array",
      "settings": {
        "foreground": "#2AA198",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Fixed Dict Directive (FIXED_DICT)",
      "scope": "keyword.other.kbengine.fixed-dict",
      "settings": {
        "foreground": "#93A1A1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine ImplementedBy (types.xml)",
      "scope": "variable.other.kbengine.implementedby",
      "settings": {
        "foreground": "#CB4B16"
      }
    },
    {
      "name": "KBEngine ImplementedBy module path",
      "scope": "entity.name.namespace.kbengine.implmodule",
      "settings": {
        "foreground": "#2AA198"
      }
    }
  ]
}
