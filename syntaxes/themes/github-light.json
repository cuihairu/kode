{
  "name": "KBEngine (GitHub Light)",
  "semanticHighlighting": false,
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#1F2328",
    "activityBarBadge.background": "#953800",
    "sideBarTitle.foreground": "#1F2328"
  },
  "tokenColors": [
    {
      "name": "Default Foreground",
      "scope": [
        "source",
        "text.xml"
      ],
      "settings": {
        "foreground": "#1F2328"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E7781",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#CF222E"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#CF222E"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#0A3069"
      }
    },
    {
      "name": "String Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#0550AE"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#0550AE"
      }
    },
    {
      "name": "Numbers and Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#0550AE"
      }
    },
    {
      "name": "Function Names",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8250DF"
      }
    },
    {
      "name": "Function Calls",
      "scope": [
        "variable.function.call"
      ],
      "settings": {
        "foreground": "#0969DA"
      }
    },
    {
      "name": "Class Names",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#24292F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorator and self",
      "scope": [
        "variable.language",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#CF222E"
      }
    },
    {
      "name": "Attribute Names",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "XML Tag Punctuation",
      "scope": [
        "punctuation.definition.tag.xml",
        "punctuation.definition.tag.begin.xml",
        "punctuation.definition.tag.end.xml"
      ],
      "settings": {
        "foreground": "#D0D7DE"
      }
    },
    {
      "name": "XML Tags",
      "scope": [
        "entity.name.tag.xml",
        "entity.name.tag.localname.xml"
      ],
      "settings": {
        "foreground": "#CF222E"
      }
    },
    {
      "name": "XML Attribute Names",
      "scope": "entity.other.attribute-name.xml",
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "KBEngine Properties Section",
      "scope": "entity.name.tag.section.properties.kbengine",
      "settings": {
        "foreground": "#24292F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Base Methods Section",
      "scope": "entity.name.tag.section.base-methods.kbengine",
      "settings": {
        "foreground": "#8250DF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Cell Methods Section",
      "scope": "entity.name.tag.section.cell-methods.kbengine",
      "settings": {
        "foreground": "#953800",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Client Methods Section",
      "scope": "entity.name.tag.section.client-methods.kbengine",
      "settings": {
        "foreground": "#0550AE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Exposed",
      "scope": [
        "entity.name.tag.exposed.kbengine",
        "constant.language.exposed.kbengine"
      ],
      "settings": {
        "foreground": "#CF222E"
      }
    },
    {
      "name": "KBEngine Persistent",
      "scope": [
        "entity.name.tag.persistent.kbengine",
        "constant.language.persistent.kbengine"
      ],
      "settings": {
        "foreground": "#24292F"
      }
    },
    {
      "name": "KBEngine Flags",
      "scope": "constant.language.flag.kbengine",
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "KBEngine Type Aliases",
      "scope": [
        "support.class.kbengine",
        "support.type.kbengine"
      ],
      "settings": {
        "foreground": "#953800",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Builtin Types (types.xml)",
      "scope": "support.type.kbengine.builtin",
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "KBEngine Custom Types (types.xml)",
      "scope": "entity.name.type.kbengine.custom",
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "KBEngine Array Directive (type[])",
      "scope": "keyword.other.kbengine.array",
      "settings": {
        "foreground": "#0A3069",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Fixed Dict Directive (FIXED_DICT)",
      "scope": "keyword.other.kbengine.fixed-dict",
      "settings": {
        "foreground": "#24292F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine ImplementedBy (types.xml)",
      "scope": "variable.other.kbengine.implementedby",
      "settings": {
        "foreground": "#0550AE"
      }
    },
    {
      "name": "KBEngine ImplementedBy module path",
      "scope": "entity.name.namespace.kbengine.implmodule",
      "settings": {
        "foreground": "#0A3069"
      }
    }
  ]
}
