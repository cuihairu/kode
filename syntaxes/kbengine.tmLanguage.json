{
  "scopeName": "source.kbengine-def",
  "comment": ".def 是 XML 方言(批110 用户定版):基准分词整体委托内建 text.xml,\n仅在其前面挂少量语义前置规则。text.xml 的标签规则是从 '<' 一步匹配\n整个标签(名字只是它的 capture),同名短规则按长度必输;因此语义规则\n写成同跨度的全标签 captures 形式——同长度时先定义者胜,且标点组显式\n还回 punctuation.definition.tag,不破坏宿主观感。语义层只做用户点名\n的引擎要素:Properties=玩家属性(金)、BaseMethods/CellMethods/\nClientMethods 三段各自分色、Exposed=客户端可请求(红)、Persistent=\n自动存储(橙)及其 true 值、Flags 值=引擎常量(橙,名单与\nsrc/kbengineMetadata.ts 的 KBENGINE_FLAGS 对齐)。前置规则不进注释与\n文本值(需 '<' 邻接或有闭合标签 lookahead),其余一律走 text.xml。\n专属着色如需扩充,应加在此处 patterns 前段,不要私造独立语法。",
  "patterns": [
    {
      "match": "(</?)(Properties)(\\s*/?>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "2": {
          "name": "entity.name.tag.section.properties.kbengine"
        },
        "3": {
          "name": "punctuation.definition.tag.end.xml"
        }
      }
    },
    {
      "match": "(</?)(BaseMethods)(\\s*/?>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "2": {
          "name": "entity.name.tag.section.base-methods.kbengine"
        },
        "3": {
          "name": "punctuation.definition.tag.end.xml"
        }
      }
    },
    {
      "match": "(</?)(CellMethods)(\\s*/?>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "2": {
          "name": "entity.name.tag.section.cell-methods.kbengine"
        },
        "3": {
          "name": "punctuation.definition.tag.end.xml"
        }
      }
    },
    {
      "match": "(</?)(ClientMethods)(\\s*/?>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "2": {
          "name": "entity.name.tag.section.client-methods.kbengine"
        },
        "3": {
          "name": "punctuation.definition.tag.end.xml"
        }
      }
    },
    {
      "match": "(</?)(Exposed)(\\s*/?>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "2": {
          "name": "entity.name.tag.exposed.kbengine"
        },
        "3": {
          "name": "punctuation.definition.tag.end.xml"
        }
      }
    },
    {
      "match": "(</?)(Persistent)(\\s*/?>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.xml"
        },
        "2": {
          "name": "entity.name.tag.persistent.kbengine"
        },
        "3": {
          "name": "punctuation.definition.tag.end.xml"
        }
      }
    },
    {
      "match": "true\\b(?=\\s*</Exposed>)",
      "name": "constant.language.exposed.kbengine"
    },
    {
      "match": "true\\b(?=\\s*</Persistent>)",
      "name": "constant.language.persistent.kbengine"
    },
    {
      "match": "\\b(CELL_PUBLIC_AND_OWN|CELL_PUBLIC|CELL_PRIVATE|CELL_AND_OTHER_CLIENTS|CELL_AND_CLIENTS|CELL_AND_CLIENT|BASE_AND_CLIENT|OTHER_CLIENTS|OWN_CLIENT|ALL_CLIENTS|CELL|BASE)\\b",
      "name": "constant.language.flag.kbengine"
    },
    {
      "include": "text.xml"
    }
  ]
}
