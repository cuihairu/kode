{
  "name": "KBEngine Dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#272822",
    "editor.foreground": "#F8F8F2",
    "activityBarBadge.background": "#66D9EF",
    "sideBarTitle.foreground": "#F8F8F2"
  },
  "tokenColors": [
    {
      "name": "Default Foreground",
      "scope": "source",
      "settings": {
        "foreground": "#F8F8F2"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#75715E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "XML Tag Punctuation",
      "scope": [
        "punctuation.definition.tag.xml",
        "punctuation.definition.tag.begin.xml",
        "punctuation.definition.tag.end.xml"
      ],
      "settings": {
        "foreground": "#969696"
      }
    },
    {
      "name": "XML Tags",
      "scope": ["entity.name.tag.xml", "entity.name.tag.localname.xml"],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "XML Attribute Names",
      "scope": "entity.other.attribute-name.xml",
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "KBEngine Properties Section",
      "scope": "entity.name.tag.section.properties.kbengine",
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Base Methods Section",
      "scope": "entity.name.tag.section.base-methods.kbengine",
      "settings": {
        "foreground": "#98C379",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Cell Methods Section",
      "scope": "entity.name.tag.section.cell-methods.kbengine",
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Client Methods Section",
      "scope": "entity.name.tag.section.client-methods.kbengine",
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "KBEngine Exposed",
      "scope": "entity.name.tag.exposed.kbengine",
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "name": "KBEngine Exposed Value",
      "scope": "constant.language.exposed.kbengine",
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "name": "KBEngine Persistent",
      "scope": "entity.name.tag.persistent.kbengine",
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "KBEngine Persistent Value",
      "scope": "constant.language.persistent.kbengine",
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "KBEngine Flags",
      "scope": "constant.language.flag.kbengine",
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "name": "KBEngine Type Aliases",
      "scope": ["support.class.kbengine", "support.type"],
      "settings": {
        "foreground": "#A6E22E",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Common Strings",
      "scope": "string",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Common Regular Expressions",
      "scope": "string.regexp",
      "settings": {
        "foreground": "#D16969"
      }
    },
    {
      "name": "Common String Escapes",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Common Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "Common Language Constants",
      "scope": "constant.language",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Common Keywords",
      "scope": "keyword",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Common Control Keywords",
      "scope": "keyword.control",
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "name": "Common Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Common Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Common Types",
      "scope": ["entity.name.type", "support.class"],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Common Functions",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "name": "Common Attribute Names",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Common Variables",
      "scope": ["variable", "variable.parameter"],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Common Meta Tags",
      "scope": "meta.tag",
      "settings": {
        "foreground": "#969696"
      }
    },
    {
      "name": "Common String Punctuation",
      "scope": "punctuation.definition.string",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Common Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#F44747"
      }
    }
  ]
}
