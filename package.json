        },
        "kbengine.debug.remoteTargets": {
          "type": "array",
          "default": [],
          "description": "远程调试目标列表（「Attach to Remote Component」命令弹出的选择项）。远端组件需已起 debugpy 监听（通常先经 telnet 发开启调试命令），扩展以 debugpy connect 模式附加、不写 pathMappings。命令 kbengine.debug.attachRemote，同时会把这些目标追加进 launch.json",
          "items": {
            "type": "object",
            "required": [
              "name",
              "host"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "目标名（quick pick 展示，如「外网 baseapp」）"
              },
              "host": {
                "type": "string",
                "description": "服务器 IP / 主机名"
              },
              "port": {
                "type": "number",
                "description": "debugpy 监听端口，缺省 5678"
              }
            }
          }
        },
        "kbengine.debug.autoDebugpy": {
          "type": "boolean",
          "default": false,
          "description": "组件启动成功后自动经 telnet :python 层注入 debugpy.listen（逐组件端口 baseapp 5678/cellapp 5679/loginapp 5680/dbmgr 5681/logger 5682，只本机 127.0.0.1；单组件失败只记日志不阻塞启动；注入走 telnet，entitydef/早期 config 阶段已过，进程级第一行断点属二期）。开启后 kbengine.debug.updateLaunchJson 会为每组件生成 debugpy attach 配置；debugpy 包先用 kbengine.python.debugpySync 命令复制进 <assets>/scripts/common/debugpy"
        },
        "kbengine.jsoncAssociation": {
          "type": "boolean",
          "default": true,
          "description": "自动把 \"**/.kbengine/debug.json\": \"jsonc\" 写进工作区 .vscode/settings.json 的 files.associations（debug.json 是带注释的 JSONC，按 json 处理会划红线；WorkspaceFolder 级，只写自己这一个键、已有值不覆盖；kbengine.jsoncAssociation.off 命令可关闭并回收本扩展写入的条目）"
        },
