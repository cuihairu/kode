{
  "name": "kode-kbengine",
  "displayName": "Kode - KBEngine Development Environment",
  "description": "Complete language support for KBEngine game server framework with syntax highlighting, IntelliSense, and more",
  "version": "0.2.0",
  "publisher": "cuihairu",
  "author": {
    "name": "cuihairu",
    "email": "cuihairu@gmail.com"
  },
  "license": "Apache-2.0",
  "icon": "resources/logo.png",
  "galleryBanner": {
    "color": "#1296DB",
    "theme": "dark"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "kbengine",
    "game-server",
    "mmo",
    "entity",
    "def",
    "python"
  ],
  "activationEvents": [
    "onLanguage:kbengine-def",
    "onLanguage:python",
    "workspaceContains:**/*.def",
    "onCommand:kbengine.refreshExplorer",
    "onCommand:kbengine.entity.open",
    "onCommand:kbengine.entity.method.open",
    "onCommand:kbengine.database.open",
    "onCommand:kbengine.database.simulate",
    "onCommand:kbengine.database.exportSimulation",
    "onCommand:kbengine.database.checkDrift",
    "onCommand:kbengine.database.checkAllDrift",
    "onCommand:kbengine.server.start",
    "onCommand:kbengine.server.stop",
    "onCommand:kbengine.server.restart",
    "onCommand:kbengine.server.showLogs",
    "onCommand:kbengine.logs.showViewer",
    "onCommand:kbengine.logs.connect",
    "onCommand:kbengine.logs.disconnect",
    "onCommand:kbengine.logs.clear",
    "onCommand:kbengine.logs.export",
    "onCommand:kbengine.logs.scanErrors",
    "onCommand:kbengine.debug.start",
    "onCommand:kbengine.debug.attach",
    "onCommand:kbengine.debug.attachRemote",
    "onCommand:kbengine.debug.updateLaunchJson",
    "onCommand:kbengine.config.showFinal",
    "onCommand:kbengine.metrics.showSummary",
    "onCommand:kbengine.debug.createConfig",
    "onCommand:kbengine.monitoring.show",
    "onCommand:kbengine.dependency.show",
    "onCommand:kbengine.flow.show",
    "onCommand:kbengine.generator.wizard",
    "onCommand:kbengine.generator.formWizard",
    "onCommand:kbengine.generator.templates",
    "onCommand:kbengine.clientSdk.generate",
    "onCommand:kbengine.def.analyze",
    "onCommand:kbengine.project.doctor",
    "onCommand:kbengine.symbolReferences.show",
    "onCommand:kbengine.profile.start",
    "onCommand:kbengine.runtimeQuery.show",
    "onCommand:kbengine.spaces.query",
    "onCommand:kbengine.compatibility.check",
    "onCommand:kbengine.workbench.show",
    "onCommand:kbengine.snippets.generateFromSelection",
    "onCommand:kbengine.telnet.showPanel",
    "onCommand:kbengine.telnet.disconnect",
    "onCommand:kbengine.httpRequests.run",
    "onCommand:kbengine.httpRequest.run",
    "onCommand:kbengine.discovery.report",
    "onCommand:kbengine.quickActions.show",
    "onCommand:kbengine.quickActions.scanScripts",
    "onCommand:kbengine.quickActions.runDefault",
    "onCommand:kbengine.quickActions.runByName",
    "onCommand:kbengine.python.syncExtraPaths",
    "onCommand:kbengine.jsoncAssociation.off",
    "onCommand:kbengine.python.debugpySync",
    "onCommand:kbengine.hotReload.showLog",
    "onCommand:kbengine.python.exportStubs",
    "onCommand:kbengine.python.exportTypeStubs",
    "onCommand:kbengine.python.showCallChain",
    "onCommand:kbengine.hotReload.tempEdit.run",
    "onCommand:kbengine.core.showShadowDiffLog",
    "onCommand:kbengine.source.reveal"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "**/.kbengine/debug.json",
        "url": "./schemas/kbengine-debug.schema.json"
      }
    ],
    "languages": [
      {
        "id": "kbengine-def",
        "aliases": [
          "KBEngine Def",
          "kbengine-def",
          "def"
        ],
        "extensions": [
          ".def"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kbengine-def",
        "scopeName": "source.kbengine-def",
        "path": "./syntaxes/kbengine.tmLanguage.json"
      },
      {
        "scopeName": "text.kbengine-types",
        "path": "./syntaxes/kbengine-types-injection.json",
        "injectTo": [
          "text.xml"
        ]
      },
      {
        "scopeName": "text.python-constants",
        "path": "./syntaxes/python-constants-injection.json",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "scopeName": "text.python-function-calls",
        "path": "./syntaxes/python-function-calls-injection.json",
        "injectTo": [
          "source.python"
        ]
      }
    ],
    "themes": [
      {
        "label": "KBEngine Theme (Monokai)",
        "uiTheme": "vs-dark",
        "path": "./syntaxes/kbengine-color-theme.json"
      },
      {
        "label": "KBEngine (One Dark)",
        "uiTheme": "vs-dark",
        "path": "./syntaxes/themes/one-dark.json"
      },
      {
        "label": "KBEngine (Dracula)",
        "uiTheme": "vs-dark",
        "path": "./syntaxes/themes/dracula.json"
      },
      {
        "label": "KBEngine (GitHub Light)",
        "uiTheme": "vs-light",
        "path": "./syntaxes/themes/github-light.json"
      },
      {
        "label": "KBEngine (Solarized Light)",
        "uiTheme": "vs-light",
        "path": "./syntaxes/themes/solarized-light.json"
      },
      {
        "label": "KBEngine (Solarized Dark)",
        "uiTheme": "vs-dark",
        "path": "./syntaxes/themes/solarized-dark.json"
      },
      {
        "label": "KBEngine (Nord)",
        "uiTheme": "vs-dark",
        "path": "./syntaxes/themes/nord.json"
      },
      {
        "label": "KBEngine (Gruvbox Dark)",
        "uiTheme": "vs-dark",
        "path": "./syntaxes/themes/gruvbox-dark.json"
      },
      {
        "label": "KBEngine (Catppuccin Mocha)",
        "uiTheme": "vs-dark",
        "path": "./syntaxes/themes/catppuccin.json"
      },
      {
        "label": "KBEngine (Visual Studio Dark+)",
        "uiTheme": "vs-dark",
        "path": "./syntaxes/themes/vs-dark-plus.json"
      },
      {
        "label": "KBEngine (Visual Studio Light+)",
        "uiTheme": "vs-light",
        "path": "./syntaxes/themes/vs-light-plus.json"
      }
    ],
    "snippets": [
      {
        "language": "kbengine-def",
        "path": "./snippets/kbengine.json"
      },
      {
        "language": "xml",
        "path": "./snippets/kbengine-types-xml.json"
      },
      {
        "language": "python",
        "path": "./snippets/kbengine-python.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kbengine-explorer",
          "title": "KBEngine Explorer",
          "icon": "resources/logo.png"
        }
      ]
    },
    "views": {
      "kbengine-explorer": [
        {
          "id": "kbengine.quickActions",
          "name": "快速执行"
        },
        {
          "id": "kbengine.entityExplorer",
          "name": "Entities"
        },
        {
          "id": "kbengine.serverControl",
          "name": "Servers"
        },
        {
          "id": "kbengine.telnetStatus",
          "name": "Telnet",
          "when": "kbengine.telnetConfigured"
        },
        {
          "id": "kbengine.config",
          "name": "Config"
        }
      ]
    },
    "commands": [
      {
        "command": "kbengine.refreshExplorer",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kbengine.entity.open",
        "title": "Open Entity Definition",
        "icon": "$(go-to-file)"
      },
      {
        "command": "kbengine.entity.method.open",
        "title": "Open Entity Method",
        "icon": "$(symbol-method)"
      },
      {
        "command": "kbengine.database.open",
        "title": "Open Database Schema",
        "icon": "$(database)"
      },
      {
        "command": "kbengine.database.simulate",
        "title": "Simulate Entity Database",
        "icon": "$(database)"
      },
      {
        "command": "kbengine.database.exportSimulation",
        "title": "Export Entity Database Simulation",
        "icon": "$(save)"
      },
      {
        "command": "kbengine.database.checkDrift",
        "title": "Check Database Drift",
        "icon": "$(check)"
      },
      {
        "command": "kbengine.database.checkAllDrift",
        "title": "Check All Database Drift",
        "icon": "$(database)"
      },
      {
        "command": "kbengine.server.start",
        "title": "Start Server",
        "icon": "$(play)"
      },
      {
        "command": "kbengine.server.stop",
        "title": "Stop Server",
        "icon": "$(stop)"
      },
      {
        "command": "kbengine.server.restart",
        "title": "Restart Server",
        "icon": "$(refresh)"
      },
      {
        "command": "kbengine.server.showLogs",
        "title": "Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "kbengine.logs.showViewer",
        "title": "Show Log Viewer",
        "icon": "$(list-tree)"
      },
      {
        "command": "kbengine.logs.connect",
        "title": "Connect to Logger",
        "icon": "$(plug)"
      },
      {
        "command": "kbengine.logs.disconnect",
        "title": "Disconnect from Logger",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "kbengine.logs.clear",
        "title": "Clear Logs",
        "icon": "$(clear-all)"
      },
      {
        "command": "kbengine.logs.export",
        "title": "Export Logs",
        "icon": "$(save)"
      },
      {
        "command": "kbengine.logs.scanErrors",
        "title": "Scan Raw Log Errors",
        "icon": "$(search)"
      },
      {
        "command": "kbengine.debug.start",
        "title": "Start Debugging",
        "icon": "$(bug)"
      },
      {
        "command": "kbengine.debug.attach",
        "title": "Attach to Component",
        "icon": "$(plug)"
      },
      {
        "command": "kbengine.debug.attachRemote",
        "title": "Attach to Remote Component"
      },
      {
        "command": "kbengine.config.showFinal",
        "title": "Show Final Server Config"
      },
      {
        "command": "kbengine.debug.updateLaunchJson",
        "title": "Update launch.json",
        "icon": "$(refresh)"
      },
      {
        "command": "kbengine.metrics.showSummary",
        "title": "Show Language Service Metrics Summary",
        "category": "KBEngine"
      },
      {
        "command": "kbengine.debug.createConfig",
        "title": "Create Debug Config Template",
        "icon": "$(file-create)"
      },
      {
        "command": "kbengine.monitoring.show",
        "title": "Show Monitoring Panel",
        "icon": "$(graph)"
      },
      {
        "command": "kbengine.dependency.show",
        "title": "Show Entity Dependency Graph",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "kbengine.flow.show",
        "title": "Show Entity Flow Graph",
        "icon": "$(circuit-board)"
      },
      {
        "command": "kbengine.generator.wizard",
        "title": "Create Entity from Wizard",
        "icon": "$(new-file)"
      },
      {
        "command": "kbengine.generator.formWizard",
        "title": "Create Def Form from Wizard",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "kbengine.generator.templates",
        "title": "Create Entity from Template",
        "icon": "$(file-template)"
      },
      {
        "command": "kbengine.clientSdk.generate",
        "title": "Generate Client Entity SDK",
        "icon": "$(symbol-method)"
      },
      {
        "command": "kbengine.def.analyze",
        "title": "Analyze Def Performance"
      },
      {
        "command": "kbengine.project.doctor",
        "title": "Run Project Doctor",
        "icon": "$(checklist)"
      },
      {
        "command": "kbengine.symbolReferences.show",
        "title": "Show Symbol References Graph",
        "icon": "$(graph)"
      },
      {
        "command": "kbengine.profile.start",
        "title": "Start Runtime Profile"
      },
      {
        "command": "kbengine.python.showCallChain",
        "title": "Show Call Chain"
      },
      {
        "command": "kbengine.runtimeQuery.show",
        "title": "Show Runtime Query Panel"
      },
      {
        "command": "kbengine.spaces.query",
        "title": "Query Spaces"
      },
      {
        "command": "kbengine.compatibility.check",
        "title": "Check Engine Compatibility"
      },
      {
        "command": "kbengine.workbench.show",
        "title": "Show KBEngine Workbench",
        "icon": "$(layout)"
      },
      {
        "command": "kbengine.snippets.generateFromSelection",
        "title": "Generate Snippet from Selection",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "kbengine.telnet.showPanel",
        "title": "Show Telnet Panel",
        "icon": "$(plug)"
      },
      {
        "command": "kbengine.telnet.disconnect",
        "title": "Disconnect Telnet Session",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "kbengine.httpRequests.run",
        "title": "Run HTTP Quick Request"
      },
      {
        "command": "kbengine.httpRequest.run",
        "title": "Run Named HTTP Quick Request"
      },
      {
        "command": "kbengine.hotReload.tempEdit.run",
        "title": "Temp-Edit Hot Reload (Active File)"
      },
      {
        "command": "kbengine.core.showShadowDiffLog",
        "title": "Kode Core Shadow: Show Diff Log"
      },
      {
        "command": "kbengine.discovery.report",
        "title": "Show Discovery Report"
      },
      {
        "command": "kbengine.quickActions.show",
        "title": "Run Quick Actions",
        "icon": "$(chevron-down)"
      },
      {
        "command": "kbengine.quickActions.scanScripts",
        "title": "Rescan Scripts for Quick Actions",
        "icon": "$(sync)"
      },
      {
        "command": "kbengine.quickActions.runDefault",
        "title": "Run Default Quick Action",
        "icon": "$(play)"
      },
      {
        "command": "kbengine.quickActions.runByName",
        "title": "执行快速动作"
      },
      {
        "command": "kbengine.python.syncExtraPaths",
        "title": "Sync Python Extra Paths"
      },
      {
        "command": "kbengine.jsoncAssociation.off",
        "title": "Turn Off debug.json JSONC Association"
      },
      {
        "command": "kbengine.python.debugpySync",
        "title": "Copy System debugpy into Assets"
      },
      {
        "command": "kbengine.python.exportStubs",
        "title": "Export KBEngine Python Stubs"
      },
      {
        "command": "kbengine.python.exportTypeStubs",
        "title": "Export KBEngine Python Type Stubs"
      },
      {
        "command": "kbengine.source.reveal",
        "title": "Reveal Source Location"
      },
      {
        "command": "kbengine.hotReload.showLog",
        "title": "Show Hot Reload Log"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kbengine.refreshExplorer",
          "when": "view == kbengine.entityExplorer",
          "group": "navigation@0"
        },
        {
          "command": "kbengine.server.start",
          "when": "view == kbengine.serverControl",
          "group": "navigation"
        },
        {
          "command": "kbengine.telnet.disconnect",
          "when": "view == kbengine.telnetStatus",
          "group": "navigation"
        },
        {
          "command": "kbengine.quickActions.show",
          "when": "view == kbengine.serverControl",
          "group": "navigation"
        },
        {
          "command": "kbengine.quickActions.scanScripts",
          "when": "view == kbengine.quickActions",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "kbengine.quickActions.show",
          "when": "editorLangId == kbengine-def",
          "group": "navigation"
        },
        {
          "command": "kbengine.quickActions.show",
          "when": "editorLangId == python || editorLangId == xml",
          "group": "navigation"
        },
        {
          "command": "kbengine.workbench.show",
          "group": "navigation@900"
        }
      ],
      "view/item/context": [
        {
          "command": "kbengine.server.start",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.server.stop",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.server.restart",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.server.showLogs",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.debug.start",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.debug.attach",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "kbengine.hotReload.showLog",
          "when": "false"
        },
        {
          "command": "kbengine.telnet.showPanel",
          "when": "kbengine.telnetConfigured"
        },
        {
          "command": "kbengine.telnet.disconnect",
          "when": "kbengine.telnetConfigured"
        },
        {
          "command": "kbengine.config.showFinal"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kbengine.telnet.disconnect",
        "key": "ctrl+]",
        "when": "activeWebviewPanelId == kbengine.telnetPanel"
      },
      {
        "command": "kbengine.telnet.disconnect",
        "key": "ctrl+d",
        "when": "activeWebviewPanelId == kbengine.telnetPanel"
      }
    ],
    "configuration": {
      "title": "KBEngine",
      "properties": {
        "kbengine.db.tablePrefix": {
          "type": "string",
          "default": "",
          "description": "数据库表名前缀（缺省空 = 引擎默认 tbl_；自定义前缀用于指向改过前缀的工程，schema 视图与 SQL 模板同源替换）"
        },
        "kbengine.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "启用 KBEngine 实时语法检查"
        },
        "kbengine.enableStructureDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "启用 .def 结构化校验（重复定义、标签位置、缺失字段等）"
        },
        "kbengine.receiverNoneDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Python 侧诊断：self.client/self.cell/self.base 无判空 guard 的引用报 Warning，含 .def 段错配检查（default: enabled）；关闭后 Python 文档零诊断产出"
        },
        "kbengine.diagnostics.checkUnknownTypes": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查未知的 KBEngine 类型"
        },
        "kbengine.diagnostics.checkUnknownFlags": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查未知的 Flags 值"
        },
        "kbengine.diagnostics.checkUnknownDetailLevels": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查未知的 DetailLevel 值"
        },
        "kbengine.diagnostics.checkDuplicateDefinitions": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查属性和方法的重复定义"
        },
        "kbengine.diagnostics.checkMissingPropertyFields": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查属性缺少 Type/Flags 或重复定义字段"
        },
        "kbengine.hover.showTagDocs": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示 .def 标签说明"
        },
        "kbengine.hover.showValueDocs": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示类型、Flags、DetailLevel 等值的说明"
        },
        "kbengine.hover.showSymbolDocs": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示自定义属性名和方法名的摘要信息"
        },
        "kbengine.hover.returnTypeInference": {
          "type": "boolean",
          "default": true,
          "description": "悬停时根据 Python 函数返回注解推导局部变量类型"
        },
        "kbengine.hover.typeStorage": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示 types.xml 自定义数据类型的存储信息(落库表/列/类型)"
        },
        "kbengine.hover.implementedBy": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示 def 方法的脚本实现位置(Implemented-By 反链)"
        },
        "kbengine.hover.entityRegistration": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示 entities.xml 实体注册信息(Utype/清单位置)"
        },
        "kbengine.hover.defChain": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示 def 属性/方法的声明链(文件与区块来源)"
        },
        "kbengine.hover.eventStats": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示事件常量的注册与监听统计(事件回调反链)"
        },
        "kbengine.hover.serverConfig": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示 kbengine.xml 服务配置项的取值与说明"
        },
        "kbengine.hover.asyncBudgetMs": {
          "type": "number",
          "default": 2500,
          "minimum": 0,
          "description": "悬停异步链总预算(毫秒):def 方法/接收者/内建属性标注链超预算即截断返回,不再永转 loading,超时层记 LogHub(过滤 [kode-hover][timeout])。≤0 关闭预算闸(旧行为)。"
        },
        "kbengine.codeLens.rpc": {
          "type": "boolean",
          "default": true,
          "description": "Python 实现脚本中显示 RPC 方法标记 CodeLens(def 声明方法声明行)"
        },
        "kbengine.codeLens.eventCallbacks": {
          "type": "boolean",
          "default": true,
          "description": "Python 脚本中显示事件回调标记 CodeLens(事件回调/监听数)"
        },
        "kbengine.codeLens.property": {
          "type": "boolean",
          "default": true,
          "description": "Python 脚本中显示 self.<属性> 访问处的属性标记 CodeLens"
        },
        "kbengine.codeLens.typesXml": {
          "type": "boolean",
          "default": true,
          "description": "types.xml 类型声明行显示落库镜链 CodeLens(引用反扫)"
        },
