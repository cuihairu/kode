          "default": "scripts/client_entities",
          "description": "客户端实体 SDK 生成器的输出目录（相对工作区根；语言清单在命令内选择，默认不覆盖已存在文件）"
        },
        "kbengine.telnet.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "telnet 探测目标主机"
        },
        "kbengine.telnet.port": {
          "type": "number",
          "default": 0,
          "description": "telnet 探测端口（0 = 未显式指定，改按元件 kbengine.xml 的 <telnet_service> 段；设置与 kbengine.xml 都未开启 telnet 时，扩展不展示任何 telnet 内容。kbengine.xml 有 <telnet_service> 段但未写端口时，逐组件端口优先读引擎 kbengine_defaults.xml 的 <telnet_service> 段（经 kbengine.binPath 推导 <引擎根>/kbe/res/server/kbengine_defaults.xml），读不到再按引擎默认端口表：loginapp 31000 / dbmgr 32000 / interfaces 33000 / logger 34000 / baseapp 40000 / cellapp 50000 / bots 51000）"
        },
        "kbengine.telnet.password": {
          "type": "string",
          "default": "",
          "description": "telnet 登录密码（仅用于自动握手写 socket，不写入日志；留空则按元件 kbengine.xml 段 → 引擎 kbengine_defaults.xml 段的顺序回落取密码；都没有则不自动登录，状态灯停在「端口开·未配密码」）"
        },
        "kbengine.telnet.enableCommands": {
          "type": "array",
          "default": [],
          "description": "telnet 面板允许发送的命令白名单（精确匹配或「命令 + 空格 + 参数」前缀匹配；:quit 恒被拒绝，会关闭服务端进程）",
          "items": {
            "type": "string"
          }
        },
        "kbengine.telnet.configXmlPath": {
          "type": "string",
          "default": "",
          "description": "可选：元件 kbengine.xml 路径，解析其 <telnet_service> 段作为端口/密码回落（支持 ${workspaceFolder}；设置显式 port > 0 时优先设置）。未设置时按约定路径探测工作区根：kbengine.xml、res/server/kbengine.xml、assets/res/server/kbengine.xml，取第一个存在的文件。元件配置未写的端口/密码继续向引擎 kbengine_defaults.xml 回落"
        },
        "kbengine.telnet.probeIntervalSeconds": {
          "type": "number",
          "default": 5,
          "description": "telnet 端口探测轮询间隔（秒，低频探测）"
        },
        "kbengine.httpRequests": {
          "type": "array",
          "default": [
            {
              "name": "热更新(示例)",
              "url": "http://127.0.0.1:8000/api/hotfix?relaod=${module}",
              "method": "GET",
              "headers": {},
              "body": "",
              "enabled": false,
              "keybinding": ""
            }
          ],
          "description": "HTTP 快捷请求列表（增删改走设置界面列表编辑器，启停=条目 enabled 开关）。模板变量：${module}=按 __init__.py 包边界扫出的模块路径（entities/、fight/ 各带 __init__.py 时 entities/fight/FightAI.py → entities.fight.FightAI；base/cell 等无 __init__.py 的角色目录不算模块段，模块名即文件名去 .py）、${moduleBasename}=末段一层模块名（FightAI）、${filename}=文件名（FightAI.py）、${line}=光标行（1 起）、${sel}=选中文本；另支持 VS Code 官方变量族（${file}=绝对路径/${workspaceFolder}/${workspaceFolderBasename}/${fileBasename}/${fileBasenameNoExtension}/${fileDirname}/${fileExtname}/${relativeFile}/${relativeFileDirname}/${env:NAME}/${cwd}/${userHome}/${pathSeparator}）。变量按字面替换、不做 URL 编码；两表都不认识的占位原样保留；无活动编辑器时各变量为空串。实际快捷键经「键盘快捷方式」为命令 kbengine.httpRequest.run 配 args.name 绑定，条目 keybinding 字段仅作展示",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "请求名（quick pick 与日志标识）"
              },
              "url": {
                "type": "string",
                "description": "URL 模板，可含 ${module}/${file}/${line}/${sel}"
              },
              "method": {
                "type": "string",
                "description": "HTTP 方法，缺省 GET"
              },
              "headers": {
                "type": "object",
                "description": "请求头（值同样走模板替换）"
              },
              "body": {
                "type": "string",
                "description": "请求体（非空才随请求发送，同样走模板替换）"
              },
              "enabled": {
                "type": "boolean",
                "description": "启停开关，缺省启用"
              },
              "keybinding": {
                "type": "string",
                "description": "键位展示串（quick pick 详情列显示）"
              }
            }
          }
        },
        "kbengine.python.extraPathsSync": {
          "type": "boolean",
          "default": true,
          "description": "自动把工作区发现的 KBEngine scripts 根写入 python.analysis.extraPaths（WorkspaceFolder 级；只管理本扩展写入的那一段，用户手填路径不动；无变化不写）"
        },
        "kbengine.python.stubExport": {
          "type": "boolean",
          "default": true,
          "description": "自动把内置 KBEngine Python API 索引导出为 KBEngine.pyi 存根（内容与补全/悬停同源；与 extraPaths 接线配合供 Pylance 解析 import KBEngine；目录见 kbengine.python.stubDir）"
        },
        "kbengine.python.stubDir": {
          "type": "string",
          "default": "",
          "description": "`.pyi` 存根目录（留空则用默认约定 .kbengine/stubs，该目录归 kode 自管、内容一致时零写、陈旧才刷新；配了目录则以配置为准并在目录里扫描，已有 .pyi 视为用户资产不覆盖，没有 .pyi 才生成。支持 ${workspaceFolder}/${env:NAME} 等 VS Code 变量；也可用环境变量 KBENGINE_STUB_DIR 指定，设置优先于环境变量）"
        },
        "kbengine.python.enableMroJump": {
          "type": "boolean",
          "default": true,
          "description": "Python 跨文件 C3-MRO 与 mixin 组合根导航开关，默认开；方法使用处优先寻找 Python 实现，找不到再回退 .def 声明；关闭后不做全仓扫描，保留当前文件继承解析和 .def 导航"
        },
        "kbengine.python.callChainHints": {
          "type": "boolean",
          "default": true,
          "description": "Python 实体方法 Call Chain 提示与命令开关，默认开；关闭后不显示链入口，Show Call Chain 也不会生成预览"
        },
        "kbengine.python.callChainView": {
          "type": "string",
          "enum": [
            "graph",
            "text"
          ],
          "default": "graph",
          "enumDescriptions": [
            "Graph：面板内嵌 mermaid(npm 打包,离线可用)渲染真图",
            "Text：文本链(兜底视图)"
          ],
          "description": "Show Call Chain 面板初始视图，默认 graph；面板内可切 Tab，选择持久到工作区状态并优先于本配置"
        },
        "kbengine.python.apiMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Engine-aware KBEngine API metadata (version, source commit/description and original declaration locations; default enabled). Missing source identity shows unknown instead of invented values"
        },
        "kbengine.hotReload.enabled": {
          "type": "boolean",
          "default": false,
          "description": "文件保存/监视时自动触发指定快速动作（默认关防误触；开启后按 globs 各建一个文件监视，配置改动即时生效）"
        },
        "kbengine.hotReload.actionName": {
          "type": "string",
          "default": "",
          "description": "要触发的 quickActions 动作名（须在 .kbengine/debug.json 的 quickActions 数组里存在；留空则监视有事件也不触发）"
        },
        "kbengine.hotReload.globs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.py"
          ],
          "description": "监视的文件匹配模式（VS Code glob；每个模式各建一个文件监视）"
        },
        "kbengine.hotReload.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "触发前的去抖毫秒数（连发保存合并成一次触发；0 为不去抖）"
        },
        "kbengine.hotReload.tempEdit.enabled": {
          "type": "boolean",
          "default": false,
          "description": "临时编辑热更新 quick action 总开关（默认关防误触，与 hotReload.enabled 同口径）。开启后命令 kbengine.hotReload.tempEdit.run 才会执行：写入临时编辑 → 按 autoRestore 决定是否还原 → 经既有 quick action 通道（HTTP/终端）发 reloadScript → 结果回显输出/问题通道"
        },
        "kbengine.hotReload.tempEdit.actionName": {
          "type": "string",
          "default": "",
          "description": "第 3 步 reloadScript 按名触发的 quick action 名（HTTP 或终端动作均可；留空视为配置错误中止，不编辑不发请求）"
        },
        "kbengine.hotReload.tempEdit.autoRestore": {
          "type": "boolean",
          "default": true,
          "description": "发送 reloadScript 前是否自动还原原始内容；还原失败会中止请求并在问题通道报错（文件停留在临时编辑态需手工处理）"
        },
        "kbengine.hotReload.tempEdit.scriptRoot": {
          "type": "string",
          "default": "",
          "description": "脚本资源根（双名称解析起点：fullModule=根相对全部目录段+短名，requestModule=直接父目录+短名）；留空则回显模块名未解析，不猜测"
        },
        "kbengine.core.backend": {
          "type": "string",
          "enum": ["ts", "rust", "shadow"],
          "enumDescriptions": [
            "TS 单轨（默认）：现状真相，Rust 路径完全不参与",
            "保留值：切流前置条件未全绿前被 serving 门禁拒绝，生效轨道仍是 ts（见 docs/kode2/pr-012.md）",
            "影子比对：TS 照常服务，同参请求镜像给 kode-server 只记差异日志，Rust 结果不影响任何用户可见行为"
          ],
          "default": "ts",
          "description": "双轨后端开关（kill-switch）：默认 ts。任何非 shadow/rust 值（含拼错）一律回落 ts；改回 ts 立即停用 Rust 进程，用户无感回退。"
        },
        "kbengine.core.serverPath": {
          "type": "string",
          "default": "",
          "description": "kode-server 二进制路径（cargo build -p kode-server 产物）。仅在 backend=shadow 时使用；留空则影子比对记 rust-unavailable，不启动进程"
        },
        "kbengine.core.shadow.timeoutMs": {
          "type": "number",
          "default": 2000,
          "minimum": 0,
          "description": "影子比对镜像请求超时（毫秒）：超时只记差异日志 rust-timeout，不影响 TS 服务路径"
        },
        "kbengine.entity.builtinProperties": {
          "type": "boolean",
          "default": true,
          "description": "Entity builtin property hover and self. completion for entity scripts (default: enabled); disabled falls back to the plain symbol chain"
        },
        "kbengine.entity.receiverSections": {
          "type": "boolean",
          "default": true,
          "description": "Filter def method candidates by receiver section on self.cell./self.base./self.client. hover, go-to-definition and RPC CodeLens (default: enabled); disabled falls back to section-unaware resolution while the def signature (arg/type) gate stays on"
        },
        "kbengine.python.stubEngineTypings": {
          "type": "boolean",
          "default": true,
          "description": "Prefer the full KBEngine.pyi concatenated from a local engine typings checkout over the built-in curated catalog (default: enabled); kbengine.python.stubExport still masters the whole export"
        },
        "kbengine.python.entityStubMethods": {
          "type": "boolean",
          "default": true,
          "description": "Include the def method surface (Base/Cell/ClientMethods) in generated entity_types.pyi stubs (default: enabled); disabled keeps the properties-only stub surface"
        },
        "kbengine.python.builtinTypeInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Inline `: <type>` hints after `self.<builtin property>` accesses in entity scripts (default: enabled); double-gated by kbengine.entity.builtinProperties (master switch) and this key, disabled renders no builtin-property inlay hints"
        },
        "kbengine.types.aliasDiscovery": {
          "type": "boolean",
          "default": true,
          "description": "Discover custom types from scripts/entity_defs/alias.xml in addition to types.xml (default: enabled); disabled falls back to types.xml only"
        },
        "kbengine.runtimeQuery.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Runtime Queries panel operation surface (watcher watch-list add/remove and the result subscription stream; default: disabled). Off keeps the panel to single manual queries"
        },
        "kbengine.runtimeQuery.pollIntervalMs": {
          "type": "number",
          "minimum": 500,
          "default": 2000,
          "description": "Result subscription stream interval in milliseconds for the Runtime Queries panel (default: 2000); applies only when kbengine.runtimeQuery.enabled is on"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cuihairu/kode.git"
  },
  "bugs": {
    "url": "https://github.com/cuihairu/kode/issues"
  },
  "homepage": "https://github.com/cuihairu/kode#readme",
  "scripts": {
    "vscode:prepublish": "pnpm run compile && pnpm run bundle",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify && esbuild src/pythonParserWorker.ts --bundle --outfile=out/pythonParserWorker.js --platform=node --target=node18 --format=cjs --minify && pnpm bundle:webview",
    "bundle:webview": "node scripts/build-call-chain-viewer.mjs --entry=src/webview/defCallChainViewer.ts --outfile=media/defCallChainViewer.js",
    "watch": "tsc -watch -p ./",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "lint": "eslint src --ext ts",
    "test": "vitest run && pnpm clean && pnpm compile && tsc -p tsconfig.mocha.json && node ./out/test/runTest.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:electron": "pnpm run compile && node out/test/electron/runTest.js",
    "demo:play": "python3 tests/fixtures/kbengine-demo-assets/play_demo.py",
    "demo:verify": "python3 tests/fixtures/kbengine-demo-assets/play_demo.py --verify",
    "test:demo": "pnpm demo:verify && vitest run tests/kbengineDemoNavigation.test.ts",
    "test:demo:editor": "pnpm run compile && tsc -p tsconfig.mocha.json && node out/test/electron/runTest.js --demo",
    "test:demo:field": "pnpm run compile && tsc -p tsconfig.mocha.json && node out/test/electron/runTest.js --field",
    "package": "pnpm exec vsce package --no-dependencies",
    "publish": "pnpm exec vsce publish --no-dependencies"
  },
