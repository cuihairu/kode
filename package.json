{
  "name": "kode",
  "displayName": "Kode - KBEngine Development Environment",
  "description": "Complete language support for KBEngine game server framework with syntax highlighting, IntelliSense, and more",
  "version": "0.1.4",
  "publisher": "cuihairu",
  "author": {
    "name": "cuihairu",
    "email": "cuihairu@gmail.com"
  },
  "license": "Apache-2.0",
  "icon": "resources/logo.png",
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "kbengine",
    "game-server",
    "mmo",
    "entity",
    "def",
    "python"
  ],
  "activationEvents": [
    "onLanguage:kbengine-def",
    "workspaceContains:**/*.def",
    "onCommand:kbengine.refreshExplorer",
    "onCommand:kbengine.entity.open",
    "onCommand:kbengine.entity.method.open",
    "onCommand:kbengine.database.open",
    "onCommand:kbengine.server.start",
    "onCommand:kbengine.server.stop",
    "onCommand:kbengine.server.restart",
    "onCommand:kbengine.server.showLogs",
    "onCommand:kbengine.logs.showViewer",
    "onCommand:kbengine.logs.connect",
    "onCommand:kbengine.logs.disconnect",
    "onCommand:kbengine.logs.clear",
    "onCommand:kbengine.logs.export",
    "onCommand:kbengine.debug.start",
    "onCommand:kbengine.debug.attach",
    "onCommand:kbengine.debug.attachRemote",
    "onCommand:kbengine.debug.updateLaunchJson",
    "onCommand:kbengine.config.showFinal",
    "onCommand:kbengine.debug.createConfig",
    "onCommand:kbengine.monitoring.show",
    "onCommand:kbengine.dependency.show",
    "onCommand:kbengine.generator.wizard",
    "onCommand:kbengine.generator.templates",
    "onCommand:kbengine.def.analyze",
    "onCommand:kbengine.snippets.generateFromSelection",
    "onCommand:kbengine.telnet.showPanel",
    "onCommand:kbengine.httpRequests.run",
    "onCommand:kbengine.httpRequest.run"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kbengine-def",
        "aliases": [
          "KBEngine Def",
          "kbengine-def",
          "def"
        ],
        "extensions": [
          ".def"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kbengine-def",
        "scopeName": "source.kbengine-def",
        "path": "./syntaxes/kbengine.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "KBEngine Dark",
        "uiTheme": "vs-dark",
        "path": "./syntaxes/kbengine-color-theme.json",
        "description": "通用深色主题,覆盖常见语言(Python/JS/Go 等)的通用语法着色,.def 文件走 XML 语法并叠加引擎语义着色"
      }
    ],
    "snippets": [
      {
        "language": "kbengine-def",
        "path": "./snippets/kbengine.json"
      },
      {
        "language": "xml",
        "path": "./snippets/kbengine-types-xml.json"
      },
      {
        "language": "python",
        "path": "./snippets/kbengine-python.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kbengine-explorer",
          "title": "KBEngine Explorer",
          "icon": "resources/logo.png"
        }
      ]
    },
    "views": {
      "kbengine-explorer": [
        {
          "id": "kbengine.entityExplorer",
          "name": "Entities"
        },
        {
          "id": "kbengine.serverControl",
          "name": "Servers"
        },
        {
          "id": "kbengine.telnetStatus",
          "name": "Telnet",
          "when": "kbengine.telnetConfigured"
        },
        {
          "id": "kbengine.config",
          "name": "Config"
        }
      ]
    },
    "commands": [
      {
        "command": "kbengine.refreshExplorer",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kbengine.entity.open",
        "title": "Open Entity Definition",
        "icon": "$(go-to-file)"
      },
      {
        "command": "kbengine.entity.method.open",
        "title": "Open Entity Method",
        "icon": "$(symbol-method)"
      },
      {
        "command": "kbengine.database.open",
        "title": "Open Database Schema",
        "icon": "$(database)"
      },
      {
        "command": "kbengine.server.start",
        "title": "Start Server",
        "icon": "$(play)"
      },
      {
        "command": "kbengine.server.stop",
        "title": "Stop Server",
        "icon": "$(stop)"
      },
      {
        "command": "kbengine.server.restart",
        "title": "Restart Server",
        "icon": "$(refresh)"
      },
      {
        "command": "kbengine.server.showLogs",
        "title": "Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "kbengine.logs.showViewer",
        "title": "Show Log Viewer",
        "icon": "$(list-tree)"
      },
      {
        "command": "kbengine.logs.connect",
        "title": "Connect to Logger",
        "icon": "$(plug)"
      },
      {
        "command": "kbengine.logs.disconnect",
        "title": "Disconnect from Logger",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "kbengine.logs.clear",
        "title": "Clear Logs",
        "icon": "$(clear-all)"
      },
      {
        "command": "kbengine.logs.export",
        "title": "Export Logs",
        "icon": "$(save)"
      },
      {
        "command": "kbengine.debug.start",
        "title": "Start Debugging",
        "icon": "$(bug)"
      },
      {
        "command": "kbengine.debug.attach",
        "title": "Attach to Component",
        "icon": "$(plug)"
      },
      {
        "command": "kbengine.debug.attachRemote",
        "title": "Attach to Remote Component"
      },
      {
        "command": "kbengine.config.showFinal",
        "title": "Show Final Server Config"
      },
      {
        "command": "kbengine.debug.updateLaunchJson",
        "title": "Update launch.json",
        "icon": "$(refresh)"
      },
      {
        "command": "kbengine.debug.createConfig",
        "title": "Create Debug Config Template",
        "icon": "$(file-create)"
      },
      {
        "command": "kbengine.monitoring.show",
        "title": "Show Monitoring Panel",
        "icon": "$(graph)"
      },
      {
        "command": "kbengine.dependency.show",
        "title": "Show Entity Dependency Graph",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "kbengine.generator.wizard",
        "title": "Create Entity from Wizard",
        "icon": "$(new-file)"
      },
      {
        "command": "kbengine.generator.templates",
        "title": "Create Entity from Template",
        "icon": "$(file-template)"
      },
      {
        "command": "kbengine.def.analyze",
        "title": "Analyze Def Performance"
      },
      {
        "command": "kbengine.snippets.generateFromSelection",
        "title": "Generate Snippet from Selection",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "kbengine.telnet.showPanel",
        "title": "Show Telnet Panel",
        "icon": "$(plug)"
      },
      {
        "command": "kbengine.httpRequests.run",
        "title": "Run HTTP Quick Request"
      },
      {
        "command": "kbengine.httpRequest.run",
        "title": "Run Named HTTP Quick Request"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kbengine.refreshExplorer",
          "when": "view == kbengine.entityExplorer",
          "group": "navigation"
        },
        {
          "command": "kbengine.server.start",
          "when": "view == kbengine.serverControl",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kbengine.server.start",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.server.stop",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.server.restart",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.server.showLogs",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.debug.start",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        },
        {
          "command": "kbengine.debug.attach",
          "when": "view == kbengine.serverControl",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "kbengine.telnet.showPanel",
          "when": "kbengine.telnetConfigured"
        },
        {
          "command": "kbengine.config.showFinal"
        }
      ]
    },
    "configuration": {
      "title": "KBEngine",
      "properties": {
        "kbengine.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "启用 KBEngine 实时语法检查"
        },
        "kbengine.enableStructureDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "启用 .def 结构化校验（重复定义、标签位置、缺失字段等）"
        },
        "kbengine.diagnostics.checkUnknownTypes": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查未知的 KBEngine 类型"
        },
        "kbengine.diagnostics.checkUnknownFlags": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查未知的 Flags 值"
        },
        "kbengine.diagnostics.checkUnknownDetailLevels": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查未知的 DetailLevel 值"
        },
        "kbengine.diagnostics.checkDuplicateDefinitions": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查属性和方法的重复定义"
        },
        "kbengine.diagnostics.checkMissingPropertyFields": {
          "type": "boolean",
          "default": true,
          "description": "诊断：检查属性缺少 Type/Flags 或重复定义字段"
        },
        "kbengine.hover.showTagDocs": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示 .def 标签说明"
        },
        "kbengine.hover.showValueDocs": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示类型、Flags、DetailLevel 等值的说明"
        },
        "kbengine.hover.showSymbolDocs": {
          "type": "boolean",
          "default": true,
          "description": "悬停时显示自定义属性名和方法名的摘要信息"
        },
        "kbengine.entityDefsPath": {
          "type": "string",
          "default": "scripts/entity_defs",
          "description": "实体定义文件的默认路径"
        },
        "kbengine.entitiesXmlPath": {
          "type": "string",
          "default": "scripts/entities.xml",
          "description": "entities.xml 文件的默认路径"
        },
        "kbengine.binPath": {
          "type": "string",
          "default": "${workspaceFolder}/../kbe/bin/server",
          "description": "KBEngine 二进制文件路径，支持 ${workspaceFolder} 和 ${env:VAR}"
        },
        "kbengine.configPath": {
          "type": "string",
          "default": "${workspaceFolder}/server",
          "description": "KBEngine 配置文件路径"
        },
        "kbengine.showFinalConfigOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "扩展激活且能定位引擎默认配置(经 kbengine.binPath 推导 kbe/res/server/kbengine_defaults.xml)时,自动在后台打开合成的最终配置只读视图(kbengine-final.xml);定位失败静默跳过。kbengine.config.showFinal 命令可随时手动打开"
        },
        "kbengine.autoRefreshFinalConfig": {
          "type": "boolean",
          "default": true,
          "description": "引擎默认配置或元件 kbengine.xml 文件变更/增删后,自动重算并刷新已打开的最终配置视图内容"
        },
        "kbengine.debug.remoteTargets": {
          "type": "array",
          "default": [],
          "description": "远程调试目标列表（「Attach to Remote Component」命令弹出的选择项）。远端组件需已起 debugpy 监听（通常先经 telnet 发开启调试命令），扩展以 debugpy connect 模式附加、不写 pathMappings。命令 kbengine.debug.attachRemote，同时会把这些目标追加进 launch.json",
          "items": {
            "type": "object",
            "required": [
              "name",
              "host"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "目标名（quick pick 展示，如「外网 baseapp」）"
              },
              "host": {
                "type": "string",
                "description": "服务器 IP / 主机名"
              },
              "port": {
                "type": "number",
                "description": "debugpy 监听端口，缺省 5678"
              }
            }
          }
        },
        "kbengine.autoStart": {
          "type": "array",
          "default": [
            "machine",
            "logger",
            "dbmgr"
          ],
          "description": "自动启动的组件列表",
          "items": {
            "type": "string",
            "enum": [
              "machine",
              "logger",
              "dbmgr",
              "baseappmgr",
              "cellappmgr",
              "loginapp",
              "baseapp",
              "cellapp",
              "bots",
              "interfaces"
            ]
          }
        },
        "kbengine.loggerPort": {
          "type": "number",
          "default": 20022,
          "description": "KBEngine Logger 端口号（默认 20022）"
        },
        "kbengine.logAutoConnect": {
          "type": "boolean",
          "default": true,
          "description": "启动服务器时自动连接日志收集器"
        },
        "kbengine.maxLogEntries": {
          "type": "number",
          "default": 10000,
          "description": "最大日志条目数"
        },
        "kbengine.generator.defOutputPath": {
          "type": "string",
          "default": "scripts/entity_defs",
          "description": "代码生成器：.def 文件输出目录"
        },
        "kbengine.generator.pythonOutputPath": {
          "type": "string",
          "default": "scripts",
          "description": "代码生成器：Python 文件输出目录"
        },
        "kbengine.generator.generatePython": {
          "type": "boolean",
          "default": true,
          "description": "代码生成器：是否生成 Python 文件"
        },
        "kbengine.generator.registerInEntitiesXml": {
          "type": "boolean",
          "default": true,
          "description": "代码生成器：是否在 entities.xml 中自动注册实体"
        },
        "kbengine.telnet.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "telnet 探测目标主机"
        },
        "kbengine.telnet.port": {
          "type": "number",
          "default": 0,
          "description": "telnet 探测端口（0 = 未显式指定，改按元件 kbengine.xml 的 <telnet_service> 段；设置与 kbengine.xml 都未开启 telnet 时，扩展不展示任何 telnet 内容。kbengine.xml 有 <telnet_service> 段但未写端口时，逐组件端口优先读引擎 kbengine_defaults.xml 的 <telnet_service> 段（经 kbengine.binPath 推导 <引擎根>/kbe/res/server/kbengine_defaults.xml），读不到再按引擎默认端口表：loginapp 31000 / dbmgr 32000 / interfaces 33000 / logger 34000 / baseapp 40000 / cellapp 50000 / bots 51000）"
        },
        "kbengine.telnet.password": {
          "type": "string",
          "default": "",
          "description": "telnet 登录密码（仅用于自动握手写 socket，不写入日志；留空则按元件 kbengine.xml 段 → 引擎 kbengine_defaults.xml 段的顺序回落取密码；都没有则不自动登录，状态灯停在「端口开·未配密码」）"
        },
        "kbengine.telnet.enableCommands": {
          "type": "array",
          "default": [],
          "description": "telnet 面板允许发送的命令白名单（精确匹配或「命令 + 空格 + 参数」前缀匹配；:quit 恒被拒绝，会关闭服务端进程）",
          "items": {
            "type": "string"
          }
        },
        "kbengine.telnet.configXmlPath": {
          "type": "string",
          "default": "",
          "description": "可选：元件 kbengine.xml 路径，解析其 <telnet_service> 段作为端口/密码回落（支持 ${workspaceFolder}；设置显式 port > 0 时优先设置）。未设置时按约定路径探测工作区根：kbengine.xml、res/server/kbengine.xml、assets/res/server/kbengine.xml，取第一个存在的文件。元件配置未写的端口/密码继续向引擎 kbengine_defaults.xml 回落"
        },
        "kbengine.telnet.probeIntervalSeconds": {
          "type": "number",
          "default": 5,
          "description": "telnet 端口探测轮询间隔（秒，低频探测）"
        },
        "kbengine.httpRequests": {
          "type": "array",
          "default": [
            {
              "name": "热更新(示例)",
              "url": "http://127.0.0.1:8090/hotfix?module_name=${module}",
              "method": "GET",
              "headers": {},
              "body": "",
              "enabled": false,
              "keybinding": ""
            }
          ],
          "description": "HTTP 快捷请求列表（增删改走设置界面列表编辑器，启停=条目 enabled 开关）。模板变量：${module}=当前文件工作区相对模块路径（entities/fight/FightAI.py → entities.fight.FightAI）、${file}=文件名、${line}=光标行（1 起）、${sel}=选中文本；变量按字面替换、不做 URL 编码；无活动编辑器时各变量为空串。实际快捷键经「键盘快捷方式」为命令 kbengine.httpRequest.run 配 args.name 绑定，条目 keybinding 字段仅作展示",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "请求名（quick pick 与日志标识）"
              },
              "url": {
                "type": "string",
                "description": "URL 模板，可含 ${module}/${file}/${line}/${sel}"
              },
              "method": {
                "type": "string",
                "description": "HTTP 方法，缺省 GET"
              },
              "headers": {
                "type": "object",
                "description": "请求头（值同样走模板替换）"
              },
              "body": {
                "type": "string",
                "description": "请求体（非空才随请求发送，同样走模板替换）"
              },
              "enabled": {
                "type": "boolean",
                "description": "启停开关，缺省启用"
              },
              "keybinding": {
                "type": "string",
                "description": "键位展示串（quick pick 详情列显示）"
              }
            }
          }
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cuihairu/kode.git"
  },
  "bugs": {
    "url": "https://github.com/cuihairu/kode/issues"
  },
  "homepage": "https://github.com/cuihairu/kode#readme",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "lint": "eslint src --ext ts",
    "test": "vitest run && pnpm clean && pnpm compile && tsc -p tsconfig.mocha.json && node ./out/test/runTest.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:electron": "pnpm run compile && node out/test/electron/runTest.js",
    "package": "npm run compile && pnpm dlx @vscode/vsce@3.9.1 package --no-yarn --no-dependencies",
    "publish": "npm run compile && pnpm dlx @vscode/vsce@3.9.1 publish --no-yarn --no-dependencies"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.5.0",
    "@types/mocha": "^8.2.2",
    "@types/node": "~20.19.37",
    "@types/vscode": "^1.50.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.57.1",
    "glob": "^10.5.0",
    "mocha": "^11.7.5",
    "typescript": "^4.2.5",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^5.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
