{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CodeActionDiagnostic": {
      "description": "codeAction diagnostic input face (RUST-143 batch 3): the TS side collapses vscode.Diagnostic into pure data (code/range/related location face); the assembly decision core filters by the code gate and range intersection.",
      "properties": {
        "code": {
          "type": "string"
        },
        "range": {
          "$ref": "#/definitions/Range"
        },
        "relatedFile": {
          "default": null,
          "description": "relatedInformation[0].location.uri.fsPath (parity-family location face; omitted when absent).",
          "type": [
            "string",
            "null"
          ]
        },
        "relatedMessage": {
          "default": null,
          "description": "relatedInformation[0].message (target class name; the server falls back to the def file name when it is empty).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "range"
      ],
      "type": "object"
    },
    "CodeActionParams": {
      "description": "codeAction request params (RUST-143 batch 3): assembly-family dispatch + family inputs (registered = the near-miss universe from TS getKnownTypeContext assembly; snapshotText = the parity-family target python snapshot, TS readSharedFileSnapshot preferring the open buffer) + the diagnostic face array. The four families (typeReplacement/parityMethod/receiverNone/fixedDict) are assembled independently, producing an ActionFace descriptor array (vscode object construction and l10n titles stay with the TS thin shell).",
      "properties": {
        "diagnostics": {
          "default": [],
          "items": {
            "$ref": "#/definitions/CodeActionDiagnostic"
          },
          "type": "array"
        },
        "family": {
          "type": "string"
        },
        "range": {
          "$ref": "#/definitions/Range"
        },
        "registered": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "snapshotText": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "family",
        "range",
        "textDocument"
      ],
      "type": "object"
    },
    "CompletionOptions": {
      "description": "completion capability declaration (triggerCharacters lets the client decide when to request).",
      "properties": {
        "resolveProvider": {
          "description": "RUST-135: completionItem/resolve lazy detail face (docs/source filled in on demand).",
          "type": "boolean"
        },
        "triggerCharacters": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "resolveProvider",
        "triggerCharacters"
      ],
      "type": "object"
    },
    "CompletionParams": {
      "description": "completion request params: document identity + UTF-16 position (the trigger context is derived server-side from the text before the cursor, same contract as the TS line-prefix face).",
      "properties": {
        "position": {
          "$ref": "#/definitions/Position"
        },
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "position",
        "textDocument"
      ],
      "type": "object"
    },
    "ContentChangeEvent": {
      "properties": {
        "range": {
          "anyOf": [
            {
              "$ref": "#/definitions/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Always None under full sync (change=1); incremental sync (change=2) carries a range, with exact coordinate conversion done by kode-vfs (VFS-004)."
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "CoreResources": {
      "description": "Core process resource snapshot (RUST-026): RSS / thread count / cumulative disk IO.",
      "properties": {
        "cpuTimeMs": {
          "description": "Cumulative process CPU time in ms (utime+stime, assuming the Linux-standard CLK_TCK=100); the caller diffs two samples to get a rate",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "diskReadBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "diskWriteBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "rssBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "threads": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cpuTimeMs",
        "diskReadBytes",
        "diskWriteBytes",
        "rssBytes",
        "threads"
      ],
      "type": "object"
    },
    "DefinitionParams": {
      "description": "definition request params: document identity + UTF-16 position (same locating foundation as hover).",
      "properties": {
        "position": {
          "$ref": "#/definitions/Position"
        },
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "position",
        "textDocument"
      ],
      "type": "object"
    },
    "DeleteFilesParams": {
      "description": "LSP `DeleteFilesParams`.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/definitions/DeletedFile"
          },
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    },
    "DeletedFile": {
      "description": "LSP `DeleteFilesParams` entry (only files[].uri is consumed).",
      "properties": {
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "type": "object"
    },
    "DidChangeParams": {
      "properties": {
        "contentChanges": {
          "items": {
            "$ref": "#/definitions/ContentChangeEvent"
          },
          "type": "array"
        },
        "textDocument": {
          "$ref": "#/definitions/VersionedTextDocumentIdentifier"
        }
      },
      "required": [
        "contentChanges",
        "textDocument"
      ],
      "type": "object"
    },
    "DidCloseParams": {
      "properties": {
        "textDocument": {
          "$ref": "#/definitions/DidCloseTextDocumentIdentifier"
        }
      },
      "required": [
        "textDocument"
      ],
      "type": "object"
    },
    "DidCloseTextDocumentIdentifier": {
      "properties": {
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "type": "object"
    },
    "DidOpenParams": {
      "properties": {
        "textDocument": {
          "$ref": "#/definitions/TextDocumentItem"
        }
      },
      "required": [
        "textDocument"
      ],
      "type": "object"
    },
    "DocumentDiagnosticParams": {
      "description": "Document identity for the definition request (same shape as hover; a separate type keeps LSP semantics clear).",
      "properties": {
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "textDocument"
      ],
      "type": "object"
    },
    "DocumentSummary": {
      "description": "Open-document summary (uri + version only, no text body).",
      "properties": {
        "uri": {
          "type": "string"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uri",
        "version"
      ],
      "type": "object"
    },
    "DocumentSymbolParams": {
      "description": "documentSymbol request params: document identity only (the Outline face is recomputed server-side from the synced document text; no position/context input; a separate type keeps LSP semantics clear).",
      "properties": {
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "textDocument"
      ],
      "type": "object"
    },
    "FileChangedParams": {
      "description": "`$/kode/fileChanged` notification params: pure data, no vscode binding -- when watch is sunk into rust later, TS is just a consumer and the protocol stays character for character. Fields are isomorphic to TS `NonPythonChangeEvent` (fsPath/identity/kind/version/fileName/ext/sha256/handledBy).",
      "properties": {
        "ext": {
          "description": "Lowercase extension with the leading dot (`.def`); empty string when there is no extension",
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "fsPath": {
          "description": "Path as-is",
          "type": "string"
        },
        "handledBy": {
          "description": "\"python\" | \"rust\" | \"unrouted\" (the handler the route resolved to)",
          "type": "string"
        },
        "identity": {
          "description": "Normalized identity key (slash / dot-segment normalization)",
          "type": "string"
        },
        "kind": {
          "description": "\"create\" | \"change\" | \"delete\"",
          "type": "string"
        },
        "sha256": {
          "description": "Content sha256 hex; None on deletion or when unreadable (never fabricated)",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "On-disk version token `${mtimeMs}:${size}`; None when unavailable (never fabricated)",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ext",
        "fileName",
        "fsPath",
        "handledBy",
        "identity",
        "kind"
      ],
      "type": "object"
    },
    "HealthReport": {
      "description": "`$/kode/health` response: startup probe / health status / observable recovery reason (CORE-016). `restart_generation` grows on the TS side so the client can reconcile after a crash restart.",
      "properties": {
        "documents": {
          "items": {
            "$ref": "#/definitions/DocumentSummary"
          },
          "type": "array"
        },
        "initialized": {
          "type": "boolean"
        },
        "pid": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/definitions/CoreResources"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RUST-026 Core process resource observation; non-Linux or /proc parse failure = None (honest degradation)"
        },
        "restartGeneration": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "serverVersion": {
          "type": "string"
        },
        "shutdownRequested": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "uptimeMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "documents",
        "initialized",
        "pid",
        "restartGeneration",
        "serverVersion",
        "shutdownRequested",
        "status",
        "uptimeMs"
      ],
      "type": "object"
    },
    "HoverParams": {
      "description": "hover request params: document identity + UTF-16 position (same semantics as Position).",
      "properties": {
        "position": {
          "$ref": "#/definitions/Position"
        },
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "position",
        "textDocument"
      ],
      "type": "object"
    },
    "IncomingMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/Request"
        },
        {
          "$ref": "#/definitions/Notification"
        }
      ],
      "description": "Inbound message: request (with id) or notification (no id). Untagged, distinguished by fields."
    },
    "InitializeParams": {
      "description": "`initialize` request params (only the fields this slice cares about; the rest pass through and are dropped).",
      "properties": {
        "capabilities": {
          "default": null
        },
        "initializationOptions": {
          "default": null,
          "description": "kode2 extension slot: client state such as restartGeneration is passed in here (CORE-015 parity comparison)."
        },
        "processId": {
          "default": null,
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "rootUri": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceFolders": {
          "default": null,
          "description": "LSP multi-workspace folders (VFS-009/KBUG-ROOT): registered one by one as resource roots, the basis for attributing same-named entities across roots; defaults to only rootUri.",
          "items": {
            "$ref": "#/definitions/WorkspaceFolder"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "InitializeResult": {
      "description": "`initialize` response.",
      "properties": {
        "capabilities": {
          "$ref": "#/definitions/ServerCapabilities"
        },
        "serverInfo": {
          "$ref": "#/definitions/ServerInfo"
        }
      },
      "required": [
        "capabilities",
        "serverInfo"
      ],
      "type": "object"
    },
    "Notification": {
      "description": "JSON-RPC notification.",
      "properties": {
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "default": null
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "Position": {
      "description": "LSP position (character counted in UTF-16 code units; semantics per kode-vfs VFS-004).",
      "properties": {
        "character": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "character",
        "line"
      ],
      "type": "object"
    },
    "PrepareRenameParams": {
      "description": "prepareRename request params (RUST-141 batch 2): document identity + UTF-16 position -- renamable-symbol resolution and the candidate-name range are recomputed server-side from the synced document.",
      "properties": {
        "position": {
          "$ref": "#/definitions/Position"
        },
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "position",
        "textDocument"
      ],
      "type": "object"
    },
    "Range": {
      "description": "LSP range.",
      "properties": {
        "end": {
          "$ref": "#/definitions/Position"
        },
        "start": {
          "$ref": "#/definitions/Position"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "ReferenceContext": {
      "description": "Reference context: `includeDeclaration` decides whether the exact declaration (that symbol's name span inside the def) counts toward the result. The types.xml face has no declaration site at all, so this flag has no effect on that face.",
      "properties": {
        "includeDeclaration": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ReferenceParams": {
      "description": "references request params: document identity + UTF-16 position + reference context (RUST-138 batch 3). `context`/`includeDeclaration` may both be omitted (omitted = no exact declaration, matching LSP ReferenceContext semantics; the client may send just the document and position).",
      "properties": {
        "context": {
          "allOf": [
            {
              "$ref": "#/definitions/ReferenceContext"
            }
          ],
          "default": {
            "includeDeclaration": false
          }
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "position",
        "textDocument"
      ],
      "type": "object"
    },
    "RenameFilesParams": {
      "description": "LSP `RenameFilesParams` (only files[].oldUri/newUri is consumed).",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/definitions/RenamedFile"
          },
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    },
    "RenameParams": {
      "description": "rename request params (RUST-141 batch 2): document identity + UTF-16 position + target name. The def-face edit and closure-conflict pre-check are recomputed server-side (the python self-access rewrite face is not part of this face).",
      "properties": {
        "newName": {
          "type": "string"
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "newName",
        "position",
        "textDocument"
      ],
      "type": "object"
    },
    "RenamedFile": {
      "description": "LSP `WorkspaceFileRename`: one rename event (old -> new).",
      "properties": {
        "newUri": {
          "type": "string"
        },
        "oldUri": {
          "type": "string"
        }
      },
      "required": [
        "newUri",
        "oldUri"
      ],
      "type": "object"
    },
    "Request": {
      "description": "JSON-RPC request.",
      "properties": {
        "id": {
          "$ref": "#/definitions/RequestId"
        },
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "default": null
        }
      },
      "required": [
        "id",
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "JSON-RPC request/response id. CORE-003: request_id threads through extension<->Core<->background tasks; both number and string forms must be preserved faithfully (normalizing to one form is forbidden)."
    },
    "Response": {
      "description": "JSON-RPC response. `id: None` is only for parse errors where the id is unknowable (the spec allows null).",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResponseError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/definitions/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "jsonrpc": {
          "type": "string"
        },
        "result": true
      },
      "required": [
        "jsonrpc"
      ],
      "type": "object"
    },
    "ResponseError": {
      "description": "JSON-RPC error object.",
      "properties": {
        "code": {
          "format": "int64",
          "type": "integer"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ServerCapabilities": {
      "description": "Server capabilities (minimal set: full text sync + hover + completion).",
      "properties": {
        "codeActionProvider": {
          "default": false,
          "description": "RUST-143 batch 3: textDocument/codeAction capability declaration (four-family assembly face).",
          "type": "boolean"
        },
        "completionProvider": {
          "anyOf": [
            {
              "$ref": "#/definitions/CompletionOptions"
            },
            {
              "type": "null"
            }
          ],
          "description": "LSP-005 / PR-011: completion provider capability declaration (trigger character `<`)."
        },
        "definitionProvider": {
          "default": false,
          "description": "Phase2 first slice: textDocument/definition capability declaration (declaration landing site).",
          "type": "boolean"
        },
        "documentSymbolProvider": {
          "default": false,
          "description": "RUST-139 batch 3: textDocument/documentSymbol capability declaration (def segment-symbol face).",
          "type": "boolean"
        },
        "hoverProvider": {
          "default": false,
          "description": "LSP-003 / PH1-03 (PR-010): hover provider capability declaration.",
          "type": "boolean"
        },
        "referencesProvider": {
          "default": false,
          "description": "RUST-138 batch 3: textDocument/references capability declaration (declaration + reference-site face).",
          "type": "boolean"
        },
        "renameProvider": {
          "default": false,
          "description": "RUST-141 batch 2: textDocument/rename+prepareRename capability declaration (def rename face).",
          "type": "boolean"
        },
        "signatureHelpProvider": {
          "default": false,
          "description": "RUST-140 batch 3: textDocument/signatureHelp capability declaration (def method signature face).",
          "type": "boolean"
        },
        "textDocumentSync": {
          "$ref": "#/definitions/TextDocumentSyncOptions"
        },
        "workspaceSymbolProvider": {
          "default": false,
          "description": "RUST-139 batch 4: workspace/symbol capability declaration (def symbol prefix-search face).",
          "type": "boolean"
        }
      },
      "required": [
        "textDocumentSync"
      ],
      "type": "object"
    },
    "ServerInfo": {
      "description": "serverInfo: the TS side validates name/version at handshake (input for the BUILD-015 version-mismatch notice).",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ServerNotification": {
      "description": "Outbound notification (server -> client).",
      "properties": {
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "SignatureHelpParams": {
      "description": "signatureHelp request params (RUST-140 batch 3): python document + cursor. Starting from the inline text, the server runs call-site lexing (python_call_at, isomorphic to TS getPythonCallAtPosition) -> the inheritance-chain closure signature decision (signature_help) in this domain, with zero TS decision input throughout; the runtime entity registry chain (EntityMappingManager) does not cross this face -- signatures come from the corpus def view.",
      "properties": {
        "position": {
          "$ref": "#/definitions/Position"
        },
        "textDocument": {
          "$ref": "#/definitions/TextDocumentIdentifier"
        }
      },
      "required": [
        "position",
        "textDocument"
      ],
      "type": "object"
    },
    "TextDocumentIdentifier": {
      "properties": {
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "type": "object"
    },
    "TextDocumentItem": {
      "properties": {
        "languageId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "languageId",
        "text",
        "uri",
        "version"
      ],
      "type": "object"
    },
    "TextDocumentSyncOptions": {
      "description": "Full sync (openClose + change=1).",
      "properties": {
        "change": {
          "description": "1 = Full: didChange always carries the full text (enough for the PH1 slice; incremental sync is VFS PR-004).",
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "openClose": {
          "type": "boolean"
        }
      },
      "required": [
        "change",
        "openClose"
      ],
      "type": "object"
    },
    "VersionedTextDocumentIdentifier": {
      "properties": {
        "uri": {
          "type": "string"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uri",
        "version"
      ],
      "type": "object"
    },
    "WorkspaceFolder": {
      "description": "LSP workspace folder (an initialize.workspaceFolders entry; uri is required).",
      "properties": {
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
