<root>
	<!--
		实体注册文件(<你的资产库>/scripts/entities.xml)
		详细说明请参考：http://kbengine.org/cn/docs/configuration/entities.html
					http://www.kbengine.org/cn/docs/programming/entitydef.html
	-->

	<!-- kode demo game 模板:迷你 ARPG(Account 登录建角 / Spaces+Space 世界 /
	     Avatar 玩家 / Monster 刷怪),由 kbengine.project.createDemoGame 落盘 -->
	<Account hasClient="true"></Account>
	<Spaces hasBase="true"></Spaces>
	<Space hasBase="true" hasCell="true"></Space>
	<Avatar hasBase="true" hasCell="true" hasClient="true"></Avatar>
	<Monster hasCell="true"></Monster>
	<!-- Social / trade / mall / party (DEMO-GAME-046/047/049):
	     transient base-only session + catalog entities. -->
	<!-- Item (DEMO-GAME-014): persistent base-only item carrier
	     (depot storage / mail attachments). -->
	<Item hasBase="true"></Item>
	<!-- Equipment (DEMO-GAME-015/048): Parent=Item, wearable gear with
	     strengthen level and gem sockets. -->
	<Equipment hasBase="true"></Equipment>
	<!-- Talisman (DEMO-GAME-016): Parent=Item, charged AOE consumable. -->
	<Talisman hasBase="true"></Talisman>
	<!-- Pet (DEMO-GAME-017): base+cell companion (follow + assist). -->
	<Pet hasBase="true" hasCell="true"></Pet>
	<Trade hasBase="true"></Trade>
	<Mall hasBase="true"></Mall>
	<Party hasBase="true"></Party>
</root>
