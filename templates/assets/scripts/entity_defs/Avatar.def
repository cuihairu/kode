<root>
	<!-- 测试模型补充(组合根验收):Avatar 也混入接口 ROLE(与 Monster 同口径) -->
	<Interfaces>
		<interface> ROLE </interface>
	</Interfaces>

	<Properties>
		<name>
			<Type> STRING </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
			<DatabaseLength> 64 </DatabaseLength>
		</name>
		<level>
			<Type> UINT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
		</level>
		<hp>
			<Type> UINT32 </Type>
			<Flags> ALL_CLIENTS </Flags>
			<Default> 100 </Default>
		</hp>
		<experience>
			<!-- 基座持有(BASE_AND_CLIENT):cell 死亡销毁后经验不丢,重生满血回归;
			     修仙战役(DEMO-GAME-011)转持久化:writeToDB 落 tbl_Avatar 真列 -->
			<Type> UINT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</experience>
		<!-- 修仙面(DEMO-GAME-011):境界/五灵根/个人属性,全部持久化。
		     spiritRoots/attrs 由建角 roll 注入(DEMO-GAME-009 接线),
		     值域与规则见 common/cultivation.py 纯函数核。 -->
		<realm>
			<Type> UINT8 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</realm>
		<spiritRoots>
			<Type> SPIRIT_ROOTS </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
		</spiritRoots>
		<attrs>
			<Type> ATTRS </Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</attrs>
		<!-- 引擎保留字:cell 实体自带 position/direction(引擎建列),def 里再声明
		     position 即 EntityDef::loadDefPropertys "position is limited" 拒载——
		     真引擎起服验证发现后移除(DEMO-GAME-001)。 -->
		<sight>
			<Type> UINT16 </Type>
			<Flags> CELL_PUBLIC </Flags>
			<DetailLevel> MEDIUM </DetailLevel>
		</sight>
		<skillSlots>
			<Type>
				ARRAY
				<of> SKILL_SLOT </of>
			</Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</skillSlots>
		<!-- Friends roster (DEMO-GAME-045): BASE_AND_CLIENT so the client
		     reads the roster through property sync; persistent across
		     restarts. -->
		<friendList>
			<Type>
				ARRAY
				<of> FRIEND_INFO </of>
			</Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
		</friendList>
		<!-- Flying mounts roster (DEMO-GAME-050): persistent; ridingId =
		     current mount (0 = on foot) syncs to the client by property
		     update; flySpeed feeds cell movement while mounted. -->
		<rides>
			<Type> RIDES </Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</rides>
		<ridingId>
			<Type> UINT16 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
		</ridingId>
		<flySpeed>
			<Type> UINT16 </Type>
			<Flags> CELL_PUBLIC </Flags>
			<Default> 0 </Default>
		</flySpeed>
		<!-- Titles (DEMO-GAME-051): earned ids (names resolve client-side
		     from the DemoConsts table); curTitle = displayed one (0 = none). -->
		<titleList>
			<Type>
				ARRAY
				<of> UINT16 </of>
			</Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</titleList>
		<curTitle>
			<Type> UINT16 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</curTitle>
		<!-- Dao companion (DEMO-GAME-052): partner persisted; pending
		     proposal state is base-only and NOT persisted (a proposal
		     dies with the process). -->
		<partnerDbid>
			<Type> UINT64 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</partnerDbid>
		<partnerName>
			<Type> STRING </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> </Default>
			<Persistent> true </Persistent>
			<DatabaseLength> 64 </DatabaseLength>
		</partnerName>
		<pendingProposerDbid>
			<Type> UINT64 </Type>
			<Flags> BASE </Flags>
			<Default> 0 </Default>
		</pendingProposerDbid>
		<pendingProposerName>
			<Type> STRING </Type>
			<Flags> BASE </Flags>
			<Default> </Default>
			<DatabaseLength> 64 </DatabaseLength>
		</pendingProposerName>
		<!-- Character appearance (DEMO-GAME-053): face/hair/eye slots set
		     at creation (or salon re-set); ALL_CLIENTS so nearby players
		     see the customized face, persistent across restarts. -->
		<appearance>
			<Type> APPEARANCE </Type>
			<Flags> ALL_CLIENTS </Flags>
			<Persistent> true </Persistent>
		</appearance>
		<!-- Fashion / costumes (DEMO-GAME-054): owned ids persisted;
		     curCostume = worn one (0 = none), ALL_CLIENTS so nearby
		     players see it too. -->
		<costumeList>
			<Type>
				ARRAY
				<of> UINT16 </of>
			</Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</costumeList>
		<curCostume>
			<Type> UINT16 </Type>
			<Flags> ALL_CLIENTS </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</curCostume>
		<!-- Cultivation paths (DEMO-GAME-055): 1=sword 2=body 3=demonic
		     4=formation master 5=beast tamer (0 = none chosen). Per-path
		     trait table lives on the pure-function face; bodyLevel =
		     flesh tempering stage (body path core mechanic). -->
		<path>
			<Type> UINT8 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</path>
		<bodyLevel>
			<Type> UINT8 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</bodyLevel>
		<!-- Reincarnation (DEMO-GAME-056): being killed ends this body —
		     death sends the cultivator into the samsara flow (client
		     picks up via onReincarnateStart); the run counter persists,
		     keep/lose settlement happens on the base face. -->
		<reincarnations>
			<Type> UINT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</reincarnations>
		<!-- Body seizing (DEMO-GAME-057): another soul can seize this
		     body (duo she); seizedByDbid marks the occupying soul
		     (0 = own soul). Not persisted: a seizure ends with the
		     process or when the victim reincarnates. -->
		<seizedByDbid>
			<Type> UINT64 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
		</seizedByDbid>
		<!-- Ranked PvP ladder (DEMO-GAME-059): points accumulate per
		     match result; tier derives from points on the pure-function
		     face; matches run in a ranked arena space (spaceKind = 2). -->
		<rankPoints>
			<Type> UINT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</rankPoints>
		<!-- Equipment depot (DEMO-GAME-060): extra equipment storage
		     beyond the bag. EQUIPMENT ONLY — flying craft, skills,
		     wings, pets, codices and ranking boards are out of scope
		     (2026-11-28 user order). -->
		<equipDepot>
			<Type>
				ARRAY
				<of> EQUIP_SLOT </of>
			</Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</equipDepot>
		<!-- Bounty board (DEMO-GAME-061): the bounty this avatar has
		     accepted (0 = none); the board itself lives on Bounty
		     entities (def lands with the implementation batch, same
		     as Mall). -->
		<acceptedBountyId>
			<Type> UINT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
		</acceptedBountyId>
		<!-- Mercenaries (DEMO-GAME-062): hired fighters roster;
		     hiredMercId = the one currently summoned (0 = none),
		     summon flow mirrors pet summon. -->
		<mercList>
			<Type> MERCS </Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</mercList>
		<hiredMercId>
			<Type> UINT16 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
		</hiredMercId>
		<!-- Dominant spirit root (DEMO-GAME-012): cell-face bridge for
		     the five-element damage multiplier; the base derives it from
		     spiritRoots (BASE_AND_CLIENT, invisible on the cell face)
		     and injects it through cellData right before
		     createCellEntity. 0 = neutral (no root). -->
		<dominantRoot>
			<Type> UINT8 </Type>
			<Flags> CELL_PUBLIC </Flags>
			<Default> 0 </Default>
		</dominantRoot>
		<!-- Operations activities (DEMO-GAME-067): first-recharge claim
		     flag, monthly-card expiry day (0 = none), VIP tier. Task-type
		     activities ride the Task face, not properties. -->
		<firstRechargeDone>
			<Type> UINT8 </Type>
			<Flags> BASE </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</firstRechargeDone>
		<monthlyCardUntil>
			<Type> UINT32 </Type>
			<Flags> BASE </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</monthlyCardUntil>
		<vipLevel>
			<Type> UINT8 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</vipLevel>
		<!-- Race (DEMO-GAME-069): 1 = human, 2 = yao; chosen at avatar
		     creation, open races gated by cultivation.RACES. -->
		<race>
			<Type> UINT8 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 1 </Default>
			<Persistent> true </Persistent>
		</race>
		<!-- Worn equipment (DEMO-GAME-015): EQUIP_SLOT.dbid = Equipment
		     entity dbid, strengthen mirrors the entity for client sync. -->
		<equipSlots>
			<Type>
				ARRAY
				<of> EQUIP_SLOT </of>
			</Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
		</equipSlots>
	</Properties>

	<!-- 组件声明:引擎 loadComponents 逐条装载,组件 def 在 components/ 子目录 -->
	<Components>
		<bag>
			<Type> Inventory </Type>
			<Persistent> true </Persistent>
		</bag>
	</Components>

	<DetailLevels>
		<NEAR>
			<radius> 10 </radius>
			<hyst> 1 </hyst>
		</NEAR>
		<MEDIUM>
			<radius> 20 </radius>
			<hyst> 2 </hyst>
		</MEDIUM>
		<FAR>
			<radius> 30 </radius>
			<hyst> 3 </hyst>
		</FAR>
	</DetailLevels>

	<ClientMethods>
		<onRealmUp>
			<Arg> UINT8 </Arg>
		</onRealmUp>
		<onHPChanged>
			<Arg> UINT32 </Arg>
		</onHPChanged>
		<onLevelUp>
			<Arg> UINT32 </Arg>
		</onLevelUp>
		<onMonsterNear>
			<Arg> FLOAT </Arg>
			<Arg> FLOAT </Arg>
			<Arg> UINT32 </Arg>
		</onMonsterNear>
		<!-- Social / trade / mall / party faces (DEMO-GAME-044..049):
		     server -> client pushes. Requests go through the Exposed
		     base/cell methods below. -->
		<onChatMessage>
			<Arg> CHAT_MSG </Arg>
		</onChatMessage>
		<onBuyResult>
			<Arg> UINT8 </Arg>
			<Arg> UINT32 </Arg>
		</onBuyResult>
		<onTradeInvite>
			<Arg> UINT64 </Arg>
			<Arg> STRING </Arg>
			<Arg> UINT32 </Arg>
		</onTradeInvite>
		<onTradeEvent>
			<Arg> UINT32 </Arg>
			<Arg> UINT8 </Arg>
		</onTradeEvent>
		<onPartyInvite>
			<Arg> UINT64 </Arg>
			<Arg> STRING </Arg>
			<Arg> UINT32 </Arg>
		</onPartyInvite>
		<onPartyRoster>
			<Arg> PARTY_INFOS </Arg>
		</onPartyRoster>
		<onPartyStartVote>
			<Arg> UINT32 </Arg>
		</onPartyStartVote>
		<onDungeonReady>
			<Arg> UINT32 </Arg>
		</onDungeonReady>
		<!-- Titles (DEMO-GAME-051): server push when a new title is
		     earned; wearing state itself syncs via curTitle updates. -->
		<onTitleGained>
			<Arg> UINT16 </Arg>
		</onTitleGained>
		<!-- Dao companion (DEMO-GAME-052): incoming proposal push; the
		     proposer learns the outcome through onDaoPartnerReply. -->
		<onDaoProposal>
			<Arg> UINT64 </Arg>
			<Arg> STRING </Arg>
		</onDaoProposal>
		<onDaoPartnerReply>
			<Arg> UINT8 </Arg>
		</onDaoPartnerReply>
		<!-- Fashion (DEMO-GAME-054): server push when a costume is
		     gained; wearing state syncs via curCostume updates. -->
		<onCostumeGained>
			<Arg> UINT16 </Arg>
		</onCostumeGained>
		<!-- Reincarnation (DEMO-GAME-056): death pushes the client into
		     the samsara flow; arg = upcoming run number (1 = first
		     reincarnation). Settlement lands as property updates. -->
		<onReincarnateStart>
			<Arg> UINT32 </Arg>
		</onReincarnateStart>
		<!-- Body seizing (DEMO-GAME-057): victim is told whose soul
		     took over (dbid + name); attacker gets onSeizeResult
		     (1 = success, 0 = refused). -->
		<onBodySeized>
			<Arg> UINT64 </Arg>
			<Arg> STRING </Arg>
		</onBodySeized>
		<onSeizeResult>
			<Arg> UINT8 </Arg>
		</onSeizeResult>
		<!-- Strengthening (DEMO-GAME-058): result push (1 = success,
		     0 = failed) for the equipment the entry targeted; the new
		     level syncs through the equip slots roster. -->
		<onStrengthenResult>
			<Arg> UINT8 </Arg>
			<Arg> UINT64 </Arg>
		</onStrengthenResult>
		<!-- Ranked ladder (DEMO-GAME-059): match found — fight in the
		     ranked arena space (spaceKind = 2); arg = arena space id. -->
		<onRankedMatchFound>
			<Arg> UINT32 </Arg>
		</onRankedMatchFound>
		<!-- Bounty board (DEMO-GAME-061): a new bounty was posted
		     (bountyId, posterName, desc, reward); result pushes
		     (1 = success) for post/accept/turn-in entries. -->
		<onBountyPosted>
			<Arg> UINT32 </Arg>
			<Arg> STRING </Arg>
			<Arg> STRING </Arg>
			<Arg> UINT32 </Arg>
		</onBountyPosted>
		<onBountyResult>
			<Arg> UINT8 </Arg>
			<Arg> UINT32 </Arg>
		</onBountyResult>
	</ClientMethods>

	<BaseMethods>
		<reqPractice>
			<Exposed> true </Exposed>
		</reqPractice>
		<reqCastSkill>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqCastSkill>
		<cellAddExperience>
			<Arg> UINT32 </Arg>
		</cellAddExperience>
		<onAvatarDead>
		</onAvatarDead>
		<onRadarPush>
			<Arg> FLOAT </Arg>
			<Arg> FLOAT </Arg>
			<Arg> UINT32 </Arg>
		</onRadarPush>
		<!-- Chat (DEMO-GAME-044): channel 0=world 1=sect 2=private.
		     Routing to sect members / private target happens on base. -->
		<reqChatMessage>
			<Exposed> true </Exposed>
			<Arg> UINT8 </Arg>
			<Arg> STRING </Arg>
		</reqChatMessage>
		<!-- Friends (DEMO-GAME-045): demo-scale roster addressed by name. -->
		<reqAddFriend>
			<Exposed> true </Exposed>
			<Arg> STRING </Arg>
		</reqAddFriend>
		<reqDelFriend>
			<Exposed> true </Exposed>
			<Arg> STRING </Arg>
		</reqDelFriend>
		<!-- Face-to-face trade (DEMO-GAME-046): tradeId = Trade entity id.
		     Distance was gated at invite time on the cell face. -->
		<reqTradeReply>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
			<Arg> UINT8 </Arg>
		</reqTradeReply>
		<reqTradeSetOffer>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
			<Arg> TRADE_OFFERS </Arg>
		</reqTradeSetOffer>
		<reqTradeLock>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqTradeLock>
		<reqTradeConfirm>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqTradeConfirm>
		<reqTradeCancel>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqTradeCancel>
		<!-- Mall (DEMO-GAME-047): goodsId indexes the Mall catalog. -->
		<reqBuyGoods>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqBuyGoods>
		<!-- Party + dungeon (DEMO-GAME-049): partyId = Party entity id. -->
		<reqCreateParty>
			<Exposed> true </Exposed>
		</reqCreateParty>
		<reqPartyInvite>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqPartyInvite>
		<reqPartyReply>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
			<Arg> UINT8 </Arg>
		</reqPartyReply>
		<reqPartyLeave>
			<Exposed> true </Exposed>
		</reqPartyLeave>
		<!-- leader only: kicks off the per-member consent vote -->
		<reqPartyStart>
			<Exposed> true </Exposed>
		</reqPartyStart>
		<reqPartyStartReply>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
			<Arg> UINT8 </Arg>
		</reqPartyStartReply>
		<!-- leader only: 0=round robin, 1=leader assign, 2=free for all -->
		<reqSetLootMode>
			<Exposed> true </Exposed>
			<Arg> UINT8 </Arg>
		</reqSetLootMode>
		<!-- Flying mounts (DEMO-GAME-050): rideId indexes the rides
		     roster; reqRideOff unmounts (ridingId back to 0). -->
		<reqRideOn>
			<Exposed> true </Exposed>
			<Arg> UINT16 </Arg>
		</reqRideOn>
		<reqRideOff>
			<Exposed> true </Exposed>
		</reqRideOff>
		<!-- Titles (DEMO-GAME-051): wear one from titleList (0 = none);
		     gaining happens server-side (realm milestones, achievements). -->
		<reqWearTitle>
			<Exposed> true </Exposed>
			<Arg> UINT16 </Arg>
		</reqWearTitle>
		<!-- Dao companion (DEMO-GAME-052): reply to a pending proposal
		     (pendingProposerDbid); 1 = accept, 0 = decline. -->
		<reqDaoPartnerReply>
			<Exposed> true </Exposed>
			<Arg> UINT8 </Arg>
		</reqDaoPartnerReply>
		<!-- Fashion (DEMO-GAME-054): wear one from costumeList (0 = none). -->
		<reqWearCostume>
			<Exposed> true </Exposed>
			<Arg> UINT16 </Arg>
		</reqWearCostume>
		<!-- Appearance (DEMO-GAME-053): creation-time face customization;
		     salon re-set goes through the same entry. -->
		<reqSetAppearance>
			<Exposed> true </Exposed>
			<Arg> APPEARANCE </Arg>
		</reqSetAppearance>
		<!-- Paths (DEMO-GAME-055): choose a cultivation path; per-path
		     trait application is implementation face. -->
		<reqChoosePath>
			<Exposed> true </Exposed>
			<Arg> UINT8 </Arg>
		</reqChoosePath>
		<!-- Body tempering (DEMO-GAME-055): flesh strengthening entry;
		     cost + success roll on base, bodyLevel grows on success. -->
		<reqTemperBody>
			<Exposed> true </Exposed>
		</reqTemperBody>
		<!-- Reincarnation (DEMO-GAME-056): client consent step of the
		     samsara flow; applies the keep/lose settlement, bumps
		     reincarnations, then respawns the body. -->
		<reqReincarnate>
			<Exposed> true </Exposed>
		</reqReincarnate>
		<!-- Equipment strengthening (DEMO-GAME-058): equipDbid targets a
		     worn/owned equipment; cost + success roll on base, the
		     EQUIP_SLOT.strengthen field grows on success. -->
		<reqStrengthenEquip>
			<Exposed> true </Exposed>
			<Arg> UINT64 </Arg>
		</reqStrengthenEquip>
		<!-- Ranked ladder (DEMO-GAME-059): join/leave matchmaking queue;
		     pairing runs on the manager face (049 Party/Space kit
		     provides the arena instance). -->
		<reqJoinRankedQueue>
			<Exposed> true </Exposed>
		</reqJoinRankedQueue>
		<reqLeaveRankedQueue>
			<Exposed> true </Exposed>
		</reqLeaveRankedQueue>
		<!-- Equipment depot (DEMO-GAME-060): deposit/withdraw by
		     equipment dbid; capacity check on base. -->
		<reqDepotDeposit>
			<Exposed> true </Exposed>
			<Arg> ITEM_ID </Arg>
			<Arg> UINT16 </Arg>
		</reqDepotDeposit>
		<reqDepotWithdraw>
			<Exposed> true </Exposed>
			<Arg> UINT64 </Arg>
		</reqDepotWithdraw>
		<!-- Equipment (DEMO-GAME-015): forge from the catalog into the
		     depot roster, wear from roster (slot + realm gate), unwear
		     back to the depot roster. -->
		<reqForgeEquip>
			<Exposed> true </Exposed>
			<Arg> UINT16 </Arg>
			<Arg> STRING </Arg>
		</reqForgeEquip>
		<reqEquipWear>
			<Exposed> true </Exposed>
			<Arg> UINT64 </Arg>
			<Arg> STRING </Arg>
		</reqEquipWear>
		<reqEquipUnwear>
			<Exposed> true </Exposed>
			<Arg> STRING </Arg>
		</reqEquipUnwear>
		<!-- Gems (DEMO-GAME-048): socket consumes one bag gem item;
		     unsocket frees the socket (gem voided at demo scale). -->
		<reqSocketGem>
			<Exposed> true </Exposed>
			<Arg> UINT64 </Arg>
			<Arg> UINT16 </Arg>
		</reqSocketGem>
		<reqUnsocketGem>
			<Exposed> true </Exposed>
			<Arg> UINT64 </Arg>
			<Arg> UINT8 </Arg>
		</reqUnsocketGem>
		<!-- Talisman (DEMO-GAME-016): use one charge, cell-side AOE;
		     last use destroys the entity. -->
		<reqUseTalisman>
			<Exposed> true </Exposed>
			<Arg> UINT64 </Arg>
		</reqUseTalisman>
		<!-- Bounty board (DEMO-GAME-061): post (desc + reward escrow on
		     base), accept, turn in for the reward. -->
		<reqPostBounty>
			<Exposed> true </Exposed>
			<Arg> STRING </Arg>
			<Arg> UINT32 </Arg>
		</reqPostBounty>
		<reqAcceptBounty>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqAcceptBounty>
		<reqTurnInBounty>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqTurnInBounty>
		<!-- Mercenaries (DEMO-GAME-062): hire (cost escrow on base),
		     dismiss, summon the hired one to fight alongside. -->
		<reqHireMerc>
			<Exposed> true </Exposed>
			<Arg> UINT16 </Arg>
		</reqHireMerc>
		<reqDismissMerc>
			<Exposed> true </Exposed>
			<Arg> UINT16 </Arg>
		</reqDismissMerc>
		<reqSummonMerc>
			<Exposed> true </Exposed>
		</reqSummonMerc>
		<!-- Operations activities (DEMO-GAME-067): one-time first
		     recharge claim, monthly-card purchase (extends expiry by
		     30 days), VIP reward claim (daily gift per tier). -->
		<reqClaimFirstRecharge>
			<Exposed> true </Exposed>
		</reqClaimFirstRecharge>
		<reqBuyMonthlyCard>
			<Exposed> true </Exposed>
		</reqBuyMonthlyCard>
		<reqClaimVipReward>
			<Exposed> true </Exposed>
		</reqClaimVipReward>
	</BaseMethods>

	<CellMethods>
		<respawn>
		</respawn>
		<reqRadarPing>
		</reqRadarPing>
		<reqGoto>
			<Exposed> true </Exposed>
		</reqGoto>
		<receiveDamage>
			<Arg> UINT32 </Arg>
			<Arg> UINT32 </Arg>
		</receiveDamage>
		<reqAttack>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqAttack>
		<!-- Face-to-face trade invite (DEMO-GAME-046): the distance gate
		     lives HERE on the cell face (entitiesInRange); target = in-view
		     entity id. -->
		<reqTradeInvite>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqTradeInvite>
		<!-- Dao companion proposal (DEMO-GAME-052): distance gate lives
		     HERE on the cell face (entitiesInRange), same as trade
		     invite; target = in-view entity id, relay goes base to base. -->
		<reqDaoProposal>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqDaoProposal>
		<!-- Body seize (DEMO-GAME-057): distance + realm gate lives on
		     the cell face; target = in-view entity id. Success migrates
		     the attacker soul in and kills the attacker old body. -->
		<reqSeizeBody>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqSeizeBody>
		<!-- Talisman AOE (DEMO-GAME-016): base relays radius + power
		     after consuming a charge; damages monsters in range via
		     the receiveDamage path. -->
		<useTalismanBlast>
			<Arg> UINT16 </Arg>
			<Arg> UINT32 </Arg>
		</useTalismanBlast>
	</CellMethods>

</root>
