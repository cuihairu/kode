<root>
	<!-- 测试模型补充(组合根验收):Avatar 也混入接口 ROLE(与 Monster 同口径) -->
	<Interfaces>
		<interface> ROLE </interface>
	</Interfaces>

	<Properties>
		<name>
			<Type> STRING </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
			<DatabaseLength> 64 </DatabaseLength>
		</name>
		<level>
			<Type> UINT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
		</level>
		<hp>
			<Type> UINT32 </Type>
			<Flags> ALL_CLIENTS </Flags>
			<Default> 100 </Default>
		</hp>
		<experience>
			<!-- 基座持有(BASE_AND_CLIENT):cell 死亡销毁后经验不丢,重生满血回归;
			     修仙战役(DEMO-GAME-011)转持久化:writeToDB 落 tbl_Avatar 真列 -->
			<Type> UINT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</experience>
		<!-- 修仙面(DEMO-GAME-011):境界/五灵根/个人属性,全部持久化。
		     spiritRoots/attrs 由建角 roll 注入(DEMO-GAME-009 接线),
		     值域与规则见 common/cultivation.py 纯函数核。 -->
		<realm>
			<Type> UINT8 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
			<Persistent> true </Persistent>
		</realm>
		<spiritRoots>
			<Type> SPIRIT_ROOTS </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
		</spiritRoots>
		<attrs>
			<Type> ATTRS </Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</attrs>
		<!-- 引擎保留字:cell 实体自带 position/direction(引擎建列),def 里再声明
		     position 即 EntityDef::loadDefPropertys "position is limited" 拒载——
		     真引擎起服验证发现后移除(DEMO-GAME-001)。 -->
		<sight>
			<Type> UINT16 </Type>
			<Flags> CELL_PUBLIC </Flags>
			<DetailLevel> MEDIUM </DetailLevel>
		</sight>
		<skillSlots>
			<Type>
				ARRAY
				<of> SKILL_SLOT </of>
			</Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</skillSlots>
		<!-- Friends roster (DEMO-GAME-045): BASE_AND_CLIENT so the client
		     reads the roster through property sync; persistent across
		     restarts. -->
		<friendList>
			<Type>
				ARRAY
				<of> FRIEND_INFO </of>
			</Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
		</friendList>
		<!-- Flying mounts roster (DEMO-GAME-050): persistent; ridingId =
		     current mount (0 = on foot) syncs to the client by property
		     update; flySpeed feeds cell movement while mounted. -->
		<rides>
			<Type> RIDES </Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</rides>
		<ridingId>
			<Type> UINT16 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Default> 0 </Default>
		</ridingId>
		<flySpeed>
			<Type> UINT16 </Type>
			<Flags> CELL_PUBLIC </Flags>
			<Default> 0 </Default>
		</flySpeed>
	</Properties>

	<!-- 组件声明:引擎 loadComponents 逐条装载,组件 def 在 components/ 子目录 -->
	<Components>
		<bag>
			<Type> Inventory </Type>
			<Persistent> true </Persistent>
		</bag>
	</Components>

	<DetailLevels>
		<NEAR>
			<radius> 10 </radius>
			<hyst> 1 </hyst>
		</NEAR>
		<MEDIUM>
			<radius> 20 </radius>
			<hyst> 2 </hyst>
		</MEDIUM>
		<FAR>
			<radius> 30 </radius>
			<hyst> 3 </hyst>
		</FAR>
	</DetailLevels>

	<ClientMethods>
		<onRealmUp>
			<Arg> UINT8 </Arg>
		</onRealmUp>
		<onHPChanged>
			<Arg> UINT32 </Arg>
		</onHPChanged>
		<onLevelUp>
			<Arg> UINT32 </Arg>
		</onLevelUp>
		<onMonsterNear>
			<Arg> FLOAT </Arg>
			<Arg> FLOAT </Arg>
			<Arg> UINT32 </Arg>
		</onMonsterNear>
		<!-- Social / trade / mall / party faces (DEMO-GAME-044..049):
		     server -> client pushes. Requests go through the Exposed
		     base/cell methods below. -->
		<onChatMessage>
			<Arg> CHAT_MSG </Arg>
		</onChatMessage>
		<onBuyResult>
			<Arg> UINT8 </Arg>
			<Arg> UINT32 </Arg>
		</onBuyResult>
		<onTradeInvite>
			<Arg> UINT64 </Arg>
			<Arg> STRING </Arg>
			<Arg> UINT32 </Arg>
		</onTradeInvite>
		<onTradeEvent>
			<Arg> UINT32 </Arg>
			<Arg> UINT8 </Arg>
		</onTradeEvent>
		<onPartyInvite>
			<Arg> UINT64 </Arg>
			<Arg> STRING </Arg>
			<Arg> UINT32 </Arg>
		</onPartyInvite>
		<onPartyRoster>
			<Arg> PARTY_INFOS </Arg>
		</onPartyRoster>
		<onPartyStartVote>
			<Arg> UINT32 </Arg>
		</onPartyStartVote>
		<onDungeonReady>
			<Arg> UINT32 </Arg>
		</onDungeonReady>
	</ClientMethods>

	<BaseMethods>
		<reqPractice>
			<Exposed> true </Exposed>
		</reqPractice>
		<reqCastSkill>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqCastSkill>
		<cellAddExperience>
			<Arg> UINT32 </Arg>
		</cellAddExperience>
		<onAvatarDead>
		</onAvatarDead>
		<onRadarPush>
			<Arg> FLOAT </Arg>
			<Arg> FLOAT </Arg>
			<Arg> UINT32 </Arg>
		</onRadarPush>
		<!-- Chat (DEMO-GAME-044): channel 0=world 1=sect 2=private.
		     Routing to sect members / private target happens on base. -->
		<reqChatMessage>
			<Exposed> true </Exposed>
			<Arg> UINT8 </Arg>
			<Arg> STRING </Arg>
		</reqChatMessage>
		<!-- Friends (DEMO-GAME-045): demo-scale roster addressed by name. -->
		<reqAddFriend>
			<Exposed> true </Exposed>
			<Arg> STRING </Arg>
		</reqAddFriend>
		<reqDelFriend>
			<Exposed> true </Exposed>
			<Arg> STRING </Arg>
		</reqDelFriend>
		<!-- Face-to-face trade (DEMO-GAME-046): tradeId = Trade entity id.
		     Distance was gated at invite time on the cell face. -->
		<reqTradeReply>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
			<Arg> UINT8 </Arg>
		</reqTradeReply>
		<reqTradeSetOffer>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
			<Arg> TRADE_OFFERS </Arg>
		</reqTradeSetOffer>
		<reqTradeLock>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqTradeLock>
		<reqTradeConfirm>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqTradeConfirm>
		<reqTradeCancel>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqTradeCancel>
		<!-- Mall (DEMO-GAME-047): goodsId indexes the Mall catalog. -->
		<reqBuyGoods>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqBuyGoods>
		<!-- Party + dungeon (DEMO-GAME-049): partyId = Party entity id. -->
		<reqCreateParty>
			<Exposed> true </Exposed>
		</reqCreateParty>
		<reqPartyInvite>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqPartyInvite>
		<reqPartyReply>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
			<Arg> UINT8 </Arg>
		</reqPartyReply>
		<reqPartyLeave>
			<Exposed> true </Exposed>
		</reqPartyLeave>
		<!-- leader only: kicks off the per-member consent vote -->
		<reqPartyStart>
			<Exposed> true </Exposed>
		</reqPartyStart>
		<reqPartyStartReply>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
			<Arg> UINT8 </Arg>
		</reqPartyStartReply>
		<!-- leader only: 0=round robin, 1=leader assign, 2=free for all -->
		<reqSetLootMode>
			<Exposed> true </Exposed>
			<Arg> UINT8 </Arg>
		</reqSetLootMode>
		<!-- Flying mounts (DEMO-GAME-050): rideId indexes the rides
		     roster; reqRideOff unmounts (ridingId back to 0). -->
		<reqRideOn>
			<Exposed> true </Exposed>
			<Arg> UINT16 </Arg>
		</reqRideOn>
		<reqRideOff>
			<Exposed> true </Exposed>
		</reqRideOff>
	</BaseMethods>

	<CellMethods>
		<respawn>
		</respawn>
		<reqRadarPing>
		</reqRadarPing>
		<reqGoto>
			<Exposed> true </Exposed>
		</reqGoto>
		<receiveDamage>
			<Arg> UINT32 </Arg>
			<Arg> UINT32 </Arg>
		</receiveDamage>
		<reqAttack>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqAttack>
		<!-- Face-to-face trade invite (DEMO-GAME-046): the distance gate
		     lives HERE on the cell face (entitiesInRange); target = in-view
		     entity id. -->
		<reqTradeInvite>
			<Exposed> true </Exposed>
			<Arg> UINT32 </Arg>
		</reqTradeInvite>
	</CellMethods>

</root>
