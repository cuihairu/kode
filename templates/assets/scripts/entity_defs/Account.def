<root>
	<Properties>
		<accountName>
			<Type> STRING </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<DatabaseLength> 128 </DatabaseLength>
		</accountName>
		<lastLoginTime>
			<Type> UINT32 </Type>
			<Flags> BASE_AND_CLIENT </Flags>
			<Persistent> true </Persistent>
		</lastLoginTime>
		<!-- DEMO-GAME-024: persistent character roster (name -> dbid); child
		     table tbl_Account_avatars lets a re-login select an existing
		     avatar and read it back from the DB (createEntityFromDBID). -->
		<avatars>
			<Type> ARRAY <of> AVATAR_INFO </of> </Type>
			<Flags> BASE </Flags>
			<Persistent> true </Persistent>
		</avatars>
	</Properties>

	<ClientMethods>
		<onLoginOK>
		</onLoginOK>
	</ClientMethods>

	<BaseMethods>
		<reqCreateAvatar>
			<Exposed> true </Exposed>
			<Arg> STRING </Arg>
			<!-- DEMO-GAME-069: 1 = human, 2 = yao (only these two open). -->
			<Arg> UINT8 </Arg>
		</reqCreateAvatar>
		<!-- DEMO-GAME-024: select a previously created avatar by name;
		     unknown names fall through to reqCreateAvatar. -->
		<reqSelectAvatar>
			<Exposed> true </Exposed>
			<Arg> STRING </Arg>
		</reqSelectAvatar>
	</BaseMethods>

	<CellMethods>
	</CellMethods>

</root>
