<root>
	<!--
		自定义类型定义文件(<你的资产库>/scripts/entity_defs/types.xml)
		详细说明请参考：http://www.kbengine.org/cn/docs/programming/user_types.html
	-->

	<!-- 别名链:ITEM_ID/ITEM_DESC 只是别名,存储与网络层用别名名 -->
	<ITEM_ID> UINT16 </ITEM_ID>
	<ITEM_DESC> STRING </ITEM_DESC>

	<!-- FIXED_DICT + implementedBy:引擎按「模块路径.实现对象」装载序列化实现;
	     FD 键的数组元素写在 <Type> 内(datatype.cpp FixedArrayType::initialize
	     从 Type 节点找 <of>),<of> 文本才是元素类型 -->
	<SKILL_SLOT>
		FIXED_DICT
		<Properties>
			<slot_list>
				<Type>
					ARRAY
					<of> UINT32 </of>
				</Type>
			</slot_list>
			<count>
				<Type> UINT32 </Type>
			</count>
		</Properties>
		<implementedBy> SKILL_SLOT_DATA.weapon_skill_slot_list_inst </implementedBy>
	</SKILL_SLOT>

	<POSITION>
		FIXED_DICT
		<Properties>
			<x>
				<Type> FLOAT </Type>
			</x>
			<y>
				<Type> FLOAT </Type>
			</y>
			<z>
				<Type> FLOAT </Type>
			</z>
		</Properties>
		<implementedBy> POSITION_DATA.position_inst </implementedBy>
	</POSITION>

	<!-- 数组自定义类型:条目指引是文本节点(datatypes.cpp loadTypes 读 FirstChild
	     的 getValStr),<of> 与文本同级,元素类型走 of 的文本(ITEM_ID ← UINT16) -->
	<ITEM_IDS>
		ARRAY
		<of> ITEM_ID </of>
	</ITEM_IDS>

	<!-- 修仙 MMO 扩展(DEMO-GAME-010):六新类型。引用只落在已声明名
	     (ITEM_ID 上文化名链),字段全内建标量——引擎 loadTypes 单遍序敏,
	     零前向引用。 -->
	<SPIRIT_ROOTS>
		FIXED_DICT
		<Properties>
			<metal>
				<Type> UINT8 </Type>
			</metal>
			<wood>
				<Type> UINT8 </Type>
			</wood>
			<water>
				<Type> UINT8 </Type>
			</water>
			<fire>
				<Type> UINT8 </Type>
			</fire>
			<earth>
				<Type> UINT8 </Type>
			</earth>
		</Properties>
	</SPIRIT_ROOTS>

	<ATTRS>
		FIXED_DICT
		<Properties>
			<maxHp>
				<Type> UINT32 </Type>
			</maxHp>
			<attack>
				<Type> UINT32 </Type>
			</attack>
			<defense>
				<Type> UINT32 </Type>
			</defense>
			<qi>
				<Type> UINT32 </Type>
			</qi>
		</Properties>
	</ATTRS>

	<ITEM_INFO>
		FIXED_DICT
		<Properties>
			<itemId>
				<Type> ITEM_ID </Type>
			</itemId>
			<count>
				<Type> UINT16 </Type>
			</count>
		</Properties>
	</ITEM_INFO>

	<EQUIP_SLOT>
		FIXED_DICT
		<Properties>
			<dbid>
				<Type> UINT64 </Type>
			</dbid>
			<strengthen>
				<Type> UINT8 </Type>
			</strengthen>
		</Properties>
	</EQUIP_SLOT>

	<PET_INFO>
		FIXED_DICT
		<Properties>
			<dbid>
				<Type> UINT64 </Type>
			</dbid>
			<name>
				<Type> STRING </Type>
			</name>
			<realm>
				<Type> UINT8 </Type>
			</realm>
		</Properties>
	</PET_INFO>

	<MEMBER_INFO>
		FIXED_DICT
		<Properties>
			<dbid>
				<Type> UINT64 </Type>
			</dbid>
			<name>
				<Type> STRING </Type>
			</name>
			<realm>
				<Type> UINT8 </Type>
			</realm>
			<rank>
				<Type> UINT8 </Type>
			</rank>
			<dept>
				<Type> UINT8 </Type>
			</dept>
		</Properties>
	</MEMBER_INFO>

	<!-- Social / trade / mall / gem types (DEMO-GAME-044..048, 2026-11-28
	     user orders). Single-pass loader: everything below only references
	     names declared earlier in this file (ITEM_ID), no forward refs. -->
	<FRIEND_INFO>
		FIXED_DICT
		<Properties>
			<dbid>
				<Type> UINT64 </Type>
			</dbid>
			<name>
				<Type> STRING </Type>
			</name>
			<realm>
				<Type> UINT8 </Type>
			</realm>
			<online>
				<Type> UINT8 </Type>
			</online>
		</Properties>
	</FRIEND_INFO>

	<TRADE_OFFER>
		FIXED_DICT
		<Properties>
			<itemId>
				<Type> ITEM_ID </Type>
			</itemId>
			<count>
				<Type> UINT16 </Type>
			</count>
		</Properties>
	</TRADE_OFFER>

	<TRADE_OFFERS>
		ARRAY
		<of> TRADE_OFFER </of>
	</TRADE_OFFERS>

	<CHAT_MSG>
		FIXED_DICT
		<Properties>
			<channel>
				<Type> UINT8 </Type>
			</channel>
			<senderDbid>
				<Type> UINT64 </Type>
			</senderDbid>
			<senderName>
				<Type> STRING </Type>
			</senderName>
			<content>
				<Type> STRING </Type>
			</content>
		</Properties>
	</CHAT_MSG>

	<MALL_GOODS>
		FIXED_DICT
		<Properties>
			<goodsId>
				<Type> UINT32 </Type>
			</goodsId>
			<itemId>
				<Type> ITEM_ID </Type>
			</itemId>
			<price>
				<Type> UINT32 </Type>
			</price>
			<stock>
				<Type> UINT32 </Type>
			</stock>
		</Properties>
	</MALL_GOODS>

	<GEM_INFO>
		FIXED_DICT
		<Properties>
			<gemId>
				<Type> UINT16 </Type>
			</gemId>
			<level>
				<Type> UINT8 </Type>
			</level>
			<attrType>
				<Type> UINT8 </Type>
			</attrType>
			<attrValue>
				<Type> UINT32 </Type>
			</attrValue>
		</Properties>
	</GEM_INFO>

	<PARTY_INFO>
		FIXED_DICT
		<Properties>
			<dbid>
				<Type> UINT64 </Type>
			</dbid>
			<name>
				<Type> STRING </Type>
			</name>
			<realm>
				<Type> UINT8 </Type>
			</realm>
			<role>
				<Type> UINT8 </Type>
			</role>
			<ready>
				<Type> UINT8 </Type>
			</ready>
		</Properties>
	</PARTY_INFO>

	<PARTY_INFOS>
		ARRAY
		<of> PARTY_INFO </of>
	</PARTY_INFOS>

	<!-- Flying mounts / sword-riding (DEMO-GAME-050, 2026-11-28 user
	     order): kind 0 = flying sword (yu jian), 1 = other craft. -->
	<RIDE_INFO>
		FIXED_DICT
		<Properties>
			<rideId>
				<Type> UINT16 </Type>
			</rideId>
			<name>
				<Type> STRING </Type>
			</name>
			<kind>
				<Type> UINT8 </Type>
			</kind>
			<speed>
				<Type> UINT16 </Type>
			</speed>
		</Properties>
	</RIDE_INFO>

	<RIDES>
		ARRAY
		<of> RIDE_INFO </of>
	</RIDES>

</root>
